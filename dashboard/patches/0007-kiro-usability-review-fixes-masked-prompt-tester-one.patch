+    () =>
+      (result?.matches ?? [])
+        .map((m) => (m.start == null || m.length == null ? '' : checkedText.slice(m.start, m.start + m.length)))
+        .filter((m) => !!m),
+    [result, checkedText],
   );
 
   return (
@@ -173,7 +179,7 @@ export const TesterPage = () => {
             {mutation.isError ? (
               <ErrorState error={mutation.error} />
