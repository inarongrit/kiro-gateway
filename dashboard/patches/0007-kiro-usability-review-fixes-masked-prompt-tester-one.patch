diff --git a/src/kiro/guardrails/api.ts b/src/kiro/guardrails/api.ts
index 315fe15..d81f1dd 100644
--- a/src/kiro/guardrails/api.ts
+++ b/src/kiro/guardrails/api.ts
@@ -97,7 +97,10 @@ export type TestResult = {
   guard_enabled: boolean;
   would_block: boolean;
   rules_checked: number;
-  matches: { id: string; label: string; matched: boolean; match?: string }[];
+  /** True when the Kiro guard's normalisation (full-width / Thai digits, zero-width chars) changed the text. */
+  normalised: boolean;
+  /** The server never returns the raw match: a masked preview plus UTF-16 offsets into the sent text. */
+  matches: { id: string; label: string; matched: boolean; preview?: string; start?: number; length?: number }[];
 };
 
 export type PatternCheck = { valid: boolean; error: string | null };
