+ * limitations under the License.
+ */
+import { Button, Collapse, Divider, Drawer, Group, ScrollArea, SimpleGrid, Stack, Text } from '@mantine/core';
+import { useDisclosure } from '@mantine/hooks';
+import { useNavigate } from '@tanstack/react-router';
+import type { FC, ReactNode } from 'react';
+import { useTranslation } from 'react-i18next';
+
+import IconChevron from '~icons/tabler/chevron-right';
+import IconFlask from '~icons/tabler/flask';
+
+import type { AuditEvent } from '../api';
+import { fmtMs, fmtNumber, fmtTime, useRuleLabel } from '../format';
+import { PathBadge, ResultBadge } from '../ui';
+import { hasPreamble, preambleText, userText } from './userText';
+
+export const TESTER_PREFILL_KEY = 'kiro:tester-prefill';
+
+const Field: FC<{ label: string; children: ReactNode }> = ({ label, children }) => (
+  <Stack gap={2}>
+    <Text size="xs" c="dimmed" tt="uppercase" fw={600}>
+      {label}
+    </Text>
+    <Text size="sm" style={{ wordBreak: 'break-word' }}>
+      {children}
+    </Text>
+  </Stack>
+);
+
+export const ActivityDrawer: FC<{ event: AuditEvent | null; onClose: () => void }> = ({ event, onClose }) => {
+  const { t, i18n } = useTranslation();
+  const ruleLabel = useRuleLabel();
+  const navigate = useNavigate();
+  const [ctxOpen, ctx] = useDisclosure(false);
+
+  const isKiro = event?.path === 'kiro';
+  const message = event ? userText(event.prompt) : '';
+  const preamble = event ? preambleText(event.prompt) : '';
+
+  const onTest = () => {
+    if (!event) return;
+    try {
+      sessionStorage.setItem(TESTER_PREFILL_KEY, message);
+    } catch {
+      /* storage may be unavailable; the tester still opens empty */
+    }
+    navigate({ to: '/guardrails/tester' });
+  };
+
+  return (
+    <Drawer
+      opened={!!event}
+      onClose={onClose}
+      position="right"
+      size="lg"
+      title={<Text fw={600}>{t('kiro.activity.drawer.title')}</Text>}
+      scrollAreaComponent={ScrollArea.Autosize}
+    >
+      {event && (
+        <Stack gap="md">
+          <Group gap="sm">
+            <ResultBadge result={event.result} />
+            <PathBadge path={event.path} />
+          </Group>
+
+          <SimpleGrid cols={{ base: 1, sm: 2 }} spacing="md" verticalSpacing="md">
+            <Field label={t('kiro.activity.col.time')}>{fmtTime(event.ts, i18n.language)}</Field>
+            <Field label={t('kiro.activity.col.rule')}>{ruleLabel(event.rule) || '–'}</Field>
+            <Field label={t('kiro.activity.col.user')}>
+              <Text span ff="monospace" size="sm">
+                {event.user}
+              </Text>
+            </Field>
+            <Field label={t('kiro.activity.drawer.host')}>{event.host || '–'}</Field>
+            <Field label={t('kiro.activity.drawer.op')}>{event.op || '–'}</Field>
+            <Field label={t('kiro.activity.drawer.status')}>{event.status || '–'}</Field>
+            <Field label={t('kiro.activity.drawer.model')}>{event.model || '–'}</Field>
+            <Field label={t('kiro.activity.drawer.tokens')}>{fmtNumber(event.tokens, i18n.language)}</Field>
+            <Field label={t('kiro.activity.col.latency')}>{fmtMs(event.latency_ms)}</Field>
+          </SimpleGrid>
+
+          <Divider />
+
+          <Stack gap={6}>
+            <Group justify="space-between" align="center">
+              <Text size="xs" c="dimmed" tt="uppercase" fw={600}>
+                {t('kiro.activity.drawer.message')}
+              </Text>
+              {isKiro && message && (
+                <Button
+                  size="compact-xs"
+                  variant="light"
+                  leftSection={<IconFlask width={14} height={14} />}
+                  onClick={onTest}
+                >
+                  {t('kiro.activity.drawer.testPrompt')}
+                </Button>
+              )}
+            </Group>
+            {isKiro ? (
+              <ScrollArea.Autosize mah={320} type="auto">
+                <Text size="sm" ff="monospace" style={{ whiteSpace: 'pre-wrap', wordBreak: 'break-word' }}>
+                  {message || t('kiro.activity.drawer.emptyMessage')}
+                </Text>
+              </ScrollArea.Autosize>
+            ) : (
+              <Text size="sm" c="dimmed" fs="italic">
+                {t('kiro.activity.notStored')}
+              </Text>
+            )}
+          </Stack>
+
+          {isKiro && event.prompt && hasPreamble(event.prompt) && (
+            <Stack gap={6}>
+              <Button
+                variant="subtle"
+                size="compact-sm"
+                justify="flex-start"
+                color="gray"
+                onClick={ctx.toggle}
+                leftSection={
+                  <IconChevron
+                    width={14}
+                    height={14}
+                    style={{ transform: ctxOpen ? 'rotate(90deg)' : 'none', transition: 'transform 150ms' }}
+                  />
+                }
+              >
+                {t('kiro.activity.drawer.contextToggle')}
+              </Button>
+              <Collapse in={ctxOpen}>
+                <ScrollArea.Autosize mah={320} type="auto">
+                  <Text size="xs" ff="monospace" c="dimmed" style={{ whiteSpace: 'pre-wrap', wordBreak: 'break-word' }}>
+                    {preamble || t('kiro.activity.drawer.emptyContext')}
+                  </Text>
+                </ScrollArea.Autosize>
+              </Collapse>
+            </Stack>
+          )}
+        </Stack>
+      )}
+    </Drawer>
+  );
+};
diff --git a/src/kiro/guardrails/activity/ActivityPage.tsx b/src/kiro/guardrails/activity/ActivityPage.tsx
