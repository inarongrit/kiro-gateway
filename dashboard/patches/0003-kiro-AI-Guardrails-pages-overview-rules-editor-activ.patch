index 0000000..1a7ad10
--- /dev/null
+++ b/src/kiro/guardrails/rules/RulesPage.tsx
@@ -0,0 +1,280 @@
+/**
+ * Licensed to the Apache Software Foundation (ASF) under one or more
+ * contributor license agreements.  See the NOTICE file distributed with
+ * this work for additional information regarding copyright ownership.
+ * The ASF licenses this file to You under the Apache License, Version 2.0
+ * (the "License"); you may not use this file except in compliance with
+ * the License.  You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+/** AI Guardrails — Block rules page (review-before-apply draft editing). */
+import { Box, Button, Card, Group, Paper, Skeleton, Stack, Text, TextInput } from '@mantine/core';
+import { useDisclosure } from '@mantine/hooks';
+import { notifications } from '@mantine/notifications';
+import { useCallback, useEffect, useMemo, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+
+import { ConsoleApiError } from '@/kiro/api';
+import { PortalPageHeader } from '@/kiro/shell/Page';
+import IconPlus from '~icons/tabler/plus';
+import IconSearch from '~icons/tabler/search';
+
+import { type GuardrailConfig, type Rule, useGuardrails, useSaveGuardrails } from '../api';
+import { EmptyState, ErrorState } from '../ui';
+import { cloneConfig, countChanges, diffConfig } from './draft';
+import { HistoryCard } from './HistoryCard';
+import { ProtectionsCard } from './ProtectionsCard';
+import { ReviewModal } from './ReviewModal';
+import { RuleDrawer } from './RuleDrawer';
+import { RulesTable } from './RulesTable';
+
+const RulesPage = () => {
+  const { t } = useTranslation();
+  const { data, isLoading, error, refetch } = useGuardrails();
+  const save = useSaveGuardrails();
+
+  const saved = data?.config as GuardrailConfig | undefined;
+  const version = data?.version;
+
+  const [draft, setDraft] = useState<GuardrailConfig | null>(null);
+  const [query, setQuery] = useState('');
+  const [editRule, setEditRule] = useState<Rule | null>(null);
+  const [drawer, { open: openDrawer, close: closeDrawer }] = useDisclosure(false);
+  const [review, { open: openReview, close: closeReview }] = useDisclosure(false);
+  const [conflict, setConflict] = useState(false);
+  const [applyError, setApplyError] = useState<string | null>(null);
+
+  // Seed the draft from the saved config the first time it loads.
+  useEffect(() => {
+    if (saved && !draft) setDraft(cloneConfig(saved));
+  }, [saved, draft]);
+
+  const diff = useMemo(
+    () => (saved && draft ? diffConfig(saved, draft) : { rules: [], switches: [], blockMessage: null }),
+    [saved, draft]
+  );
+  const changes = countChanges(diff);
+  const dirty = changes > 0;
+
+  // Warn on tab close with unsaved changes.
+  useEffect(() => {
+    if (!dirty) return;
+    const h = (e: BeforeUnloadEvent) => {
+      e.preventDefault();
+      e.returnValue = '';
+    };
+    window.addEventListener('beforeunload', h);
+    return () => window.removeEventListener('beforeunload', h);
+  }, [dirty]);
+
+  const patch = useCallback((fn: (c: GuardrailConfig) => GuardrailConfig) => {
+    setDraft((d) => (d ? fn(d) : d));
+  }, []);
+
+  const openAdd = () => {
+    setEditRule(null);
+    openDrawer();
+  };
+  const openEdit = (rule: Rule) => {
+    setEditRule(rule);
+    openDrawer();
+  };
+
+  const submitRule = (rule: Rule) => {
+    patch((c) => {
+      const idx = c.rules.findIndex((r) => r.id === rule.id);
+      const rules = [...c.rules];
+      if (idx >= 0) rules[idx] = rule;
+      else rules.push(rule);
+      return { ...c, rules };
+    });
+    closeDrawer();
+  };
+
+  const toggleRule = (id: string, enabled: boolean) =>
+    patch((c) => ({ ...c, rules: c.rules.map((r) => (r.id === id ? { ...r, enabled } : r)) }));
+
+  const moveRule = (id: string, dir: -1 | 1) =>
+    patch((c) => {
+      const i = c.rules.findIndex((r) => r.id === id);
+      const j = i + dir;
+      if (i < 0 || j < 0 || j >= c.rules.length) return c;
+      const rules = [...c.rules];
+      [rules[i], rules[j]] = [rules[j], rules[i]];
+      return { ...c, rules };
+    });
+
+  const deleteRule = (rule: Rule) =>
+    patch((c) => ({ ...c, rules: c.rules.filter((r) => r.id !== rule.id) }));
+
+  const discard = () => {
+    if (saved) setDraft(cloneConfig(saved));
+    setConflict(false);
+    setApplyError(null);
+    closeReview();
+  };
+
+  const reload = () => {
+    refetch().then((r) => {
+      if (r.data?.config) setDraft(cloneConfig(r.data.config as GuardrailConfig));
+      setConflict(false);
+      setApplyError(null);
+      closeReview();
+    });
+  };
+
+  const apply = () => {
+    if (!draft || !version) return;
+    setConflict(false);
+    setApplyError(null);
+    save.mutate(
+      { config: draft, base_version: version },
+      {
+        onSuccess: (res) => {
+          notifications.show({
+            color: 'teal',
+            title: t('kiro.rules.notify.appliedTitle'),
+            message: t('kiro.rules.notify.appliedBody', { commit: res.commit }),
+          });
+          closeReview();
+        },
+        onError: (e) => {
+          if (e instanceof ConsoleApiError && e.status === 409) {
+            setConflict(true);
+          } else {
+            setApplyError(e instanceof Error ? e.message : String(e));
+          }
+        },
+      }
+    );
+  };
+
+  const filtered = useMemo(() => {
+    if (!draft) return [];
+    const q = query.trim().toLowerCase();
+    if (!q) return draft.rules;
+    return draft.rules.filter(
+      (r) =>
+        r.label.toLowerCase().includes(q) ||
+        r.id.toLowerCase().includes(q) ||
+        r.description.toLowerCase().includes(q) ||
+        r.pattern.toLowerCase().includes(q)
+    );
+  }, [draft, query]);
+
+  const header = (
+    <PortalPageHeader
+      title={t('kiro.rules.pageTitle')}
+      subtitle={t('kiro.rules.pageSubtitle')}
+      actions={
+        <Button leftSection={<IconPlus width={16} height={16} />} onClick={openAdd} disabled={!draft}>
+          {t('kiro.rules.addRule')}
+        </Button>
+      }
+    />
+  );
+
+  if (isLoading || (!draft && !error)) {
+    return (
+      <Box maw={1440}>
+        {header}
+        <Stack>
+          <Skeleton h={320} radius="md" />
+          <Skeleton h={200} radius="md" />
+        </Stack>
+      </Box>
+    );
+  }
+
+  if (error || !draft) {
+    return (
+      <Box maw={1440}>
+        {header}
+        <Card withBorder>
+          <ErrorState error={error ?? new Error('no data')} />
+        </Card>
+      </Box>
+    );
+  }
+
+  return (
+    <Box maw={1440} pb={dirty ? 72 : 0}>
+      {header}
+
+      <Stack>
+        <Card withBorder>
+          <Group justify="space-between" mb="md" wrap="wrap" gap="sm">
+            <Text fw={600}>{t('kiro.rules.listTitle')}</Text>
+            <TextInput
+              leftSection={<IconSearch width={16} height={16} />}
+              placeholder={t('kiro.rules.searchPlaceholder')}
+              value={query}
+              onChange={(e) => setQuery(e.currentTarget.value)}
+              w={260}
+              aria-label={t('kiro.rules.searchPlaceholder')}
+            />
+          </Group>
+          {draft.rules.length === 0 ? (
+            <EmptyState title={t('kiro.rules.emptyTitle')} body={t('kiro.rules.emptyBody')} />
+          ) : filtered.length === 0 ? (
+            <EmptyState title={t('kiro.rules.noMatchTitle')} body={t('kiro.rules.noMatchBody')} />
+          ) : (
+            <RulesTable
+              rules={filtered}
+              onToggle={toggleRule}
+              onEdit={openEdit}
+              onMove={moveRule}
+              onDelete={deleteRule}
+            />
+          )}
+        </Card>
+
+        <ProtectionsCard draft={draft} patch={patch} />
+        <HistoryCard />
+      </Stack>
+
+      {dirty && (
+        <Paper shadow="md" withBorder p="sm" pos="fixed" bottom={0} left={0} right={0} style={{ zIndex: 200 }}>
+          <Group justify="space-between" maw={1440} mx="auto" wrap="wrap" gap="sm">
+            <Text fw={500}>{t('kiro.rules.sticky.count', { count: changes })}</Text>
+            <Group gap="sm">
+              <Button variant="default" onClick={discard}>
+                {t('kiro.rules.sticky.discard')}
+              </Button>
+              <Button onClick={openReview}>{t('kiro.rules.sticky.review')}</Button>
+            </Group>
+          </Group>
+        </Paper>
+      )}
+
+      <RuleDrawer
+        opened={drawer}
+        rule={editRule}
+        existing={draft.rules}
+        onClose={closeDrawer}
+        onSubmit={submitRule}
+      />
+
+      <ReviewModal
+        opened={review}
+        diff={diff}
+        count={changes}
+        saving={save.isPending}
+        conflict={conflict}
+        error={applyError}
+        onClose={closeReview}
+        onApply={apply}
+        onReload={reload}
+      />
+    </Box>
+  );
+};
+
+export default RulesPage;
