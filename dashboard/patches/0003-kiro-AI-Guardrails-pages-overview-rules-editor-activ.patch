+
+const BLOCK_MESSAGE_MAX = 300;
+
+type Patch = (fn: (c: GuardrailConfig) => GuardrailConfig) => void;
+
+const Row: FC<{ title: string; help: string; children: React.ReactNode }> = ({ title, help, children }) => (
+  <Stack gap={6}>
