+/** Horizontal ranked bars: label, proportional track and count. */
+import { Box, Group, Progress, Stack, Text } from '@mantine/core';
+import type { FC, ReactNode } from 'react';
+
+export type RankRow = { key: string; label: ReactNode; value: number };
+
+export const RankedBars: FC<{ rows: RankRow[]; color?: string; valueFmt?: (n: number) => string }> = ({
+  rows,
+  color = 'red',
+  valueFmt = (n) => String(n),
+}) => {
+  const max = Math.max(1, ...rows.map((r) => r.value));
+  return (
+    <Stack gap="sm">
+      {rows.map((r) => (
+        <Group key={r.key} gap="sm" wrap="nowrap" align="center">
+          <Box w={150} style={{ overflow: 'hidden' }}>
+            <Text size="sm" truncate>
+              {r.label}
+            </Text>
+          </Box>
+          <Progress
+            flex={1}
+            value={Math.max(3, (r.value / max) * 100)}
+            color={color}
+            size="sm"
+            radius="xl"
+            aria-hidden
+          />
+          <Text size="sm" fw={600} w={40} ta="right" style={{ fontVariantNumeric: 'tabular-nums' }}>
+            {valueFmt(r.value)}
+          </Text>
+        </Group>
+      ))}
+    </Stack>
+  );
+};
