+import {
+  Alert,
+  Badge,
+  Box,
+  Button,
+  Card,
+  Center,
+  Grid,
+  Group,
+  Highlight,
+  Mark,
+  SegmentedControl,
+  Stack,
+  Text,
+  Textarea,
+  ThemeIcon,
+} from '@mantine/core';
+import { useMutation } from '@tanstack/react-query';
+import { useEffect, useMemo, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+
+import { PortalPageHeader } from '@/kiro/shell/Page';
+import IconAlert from '~icons/tabler/alert-triangle';
+import IconCheck from '~icons/tabler/circle-check';
+import IconX from '~icons/tabler/circle-x';
+import IconFlask from '~icons/tabler/flask';
+
+import { TESTER_PREFILL_KEY } from '../activity/ActivityDrawer';
+import type { GuardPath, TestResult } from '../api';
+import { testPrompt } from '../api';
+import { fmtNumber } from '../format';
+import { ErrorState } from '../ui';
+
+const MAX_CHARS = 20000;
+
+const EXAMPLES = [
+  { label: 'kiro.tester.example.clean', text: 'How do I reverse a linked list in Python without recursion?' },
+  { label: 'kiro.tester.example.email', text: 'Please email the report to jordan.lee@example.com by Friday.' },
+  { label: 'kiro.tester.example.awsKey', text: 'Here is the key: AKIAIOSFODNN7EXAMPLE — use it to deploy.' },
+  { label: 'kiro.tester.example.thaiPhone', text: 'โทรกลับที่เบอร์ 081-234-5678 ด้วยนะครับ' },
+] as const;
+
+export const TesterPage = () => {
+  const { t, i18n } = useTranslation();
+  const [text, setText] = useState('');
+  const [path, setPath] = useState<GuardPath>('kiro');
+
+  // Pull a prefill handed over from the Activity drawer, then clear it so a reload starts fresh.
+  useEffect(() => {
+    try {
+      const pre = sessionStorage.getItem(TESTER_PREFILL_KEY);
+      if (pre) {
+        setText(pre.slice(0, MAX_CHARS));
+        sessionStorage.removeItem(TESTER_PREFILL_KEY);
+      }
+    } catch {
+      /* storage may be unavailable */
+    }
+  }, []);
+
+  const mutation = useMutation({
+    mutationFn: ({ value, p }: { value: string; p: GuardPath }) => testPrompt(value, p),
+  });
+
+  const run = () => {
+    const value = text.trim();
+    if (!value) return;
+    mutation.mutate({ value, p: path });
+  };
+
+  const onKeyDown = (e: React.KeyboardEvent) => {
+    if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') {
+      e.preventDefault();
+      run();
+    }
+  };
+
+  const result = mutation.data;
+  const matchStrings = useMemo(
+    () => (result?.matches ?? []).map((m) => m.match).filter((m): m is string => !!m),
+    [result],
+  );
+
+  return (
+    <Box maw={1440}>
+      <PortalPageHeader title={t('kiro.tester.title')} subtitle={t('kiro.tester.subtitle')} />
+      <Grid gutter="md">
+        <Grid.Col span={{ base: 12, md: 6 }}>
+          <Card withBorder h="100%">
+            <Stack gap="md">
+              <Box>
+                <Text size="sm" fw={500} mb={4}>
+                  {t('kiro.tester.path')}
+                </Text>
+                <SegmentedControl
+                  value={path}
+                  onChange={(v) => setPath(v as GuardPath)}
+                  data={[
+                    { value: 'kiro', label: t('kiro.guard.path.kiro') },
+                    { value: 'ai', label: t('kiro.guard.path.ai') },
+                  ]}
+                />
+              </Box>
+              <Textarea
+                label={t('kiro.tester.inputLabel')}
+                placeholder={t('kiro.tester.inputPlaceholder')}
+                value={text}
+                onChange={(e) => setText(e.currentTarget.value.slice(0, MAX_CHARS))}
+                onKeyDown={onKeyDown}
+                autosize
+                minRows={6}
+                maxRows={16}
+                maxLength={MAX_CHARS}
+              />
+              <Group justify="space-between">
+                <Text size="xs" c="dimmed">
+                  {t('kiro.tester.counter', {
+                    count: fmtNumber(text.length, i18n.language),
+                    max: fmtNumber(MAX_CHARS, i18n.language),
+                  })}
+                </Text>
+              </Group>
+              <Box>
+                <Text size="xs" c="dimmed" mb={6}>
+                  {t('kiro.tester.examplesLabel')}
+                </Text>
+                <Group gap="xs">
+                  {EXAMPLES.map((ex) => (
+                    <Badge
+                      key={ex.label}
+                      component="button"
+                      variant="light"
+                      color="gray"
+                      radius="sm"
+                      style={{ cursor: 'pointer' }}
+                      onClick={() => setText(ex.text)}
+                    >
+                      {t(ex.label)}
+                    </Badge>
+                  ))}
+                </Group>
+              </Box>
+              <Button
+                leftSection={<IconFlask width={16} height={16} />}
+                onClick={run}
+                loading={mutation.isPending}
+                disabled={!text.trim()}
+              >
+                {t('kiro.tester.check')}
+              </Button>
+            </Stack>
+          </Card>
+        </Grid.Col>
+
+        <Grid.Col span={{ base: 12, md: 6 }}>
+          <Card withBorder h="100%">
+            {mutation.isError ? (
+              <ErrorState error={mutation.error} />
+            ) : result ? (
+              <ResultView result={result} input={text} matchStrings={matchStrings} />
+            ) : (
+              <Center h="100%" mih={240}>
+                <Stack align="center" gap={8} maw={380}>
+                  <ThemeIcon variant="light" color="gray" size={44} radius="md">
+                    <IconFlask width={22} height={22} />
+                  </ThemeIcon>
+                  <Text fw={500}>{t('kiro.tester.idle.title')}</Text>
+                  <Text size="sm" c="dimmed" ta="center">
+                    {t('kiro.tester.idle.body')}
+                  </Text>
+                </Stack>
+              </Center>
+            )}
+          </Card>
+        </Grid.Col>
+      </Grid>
+    </Box>
+  );
+};
+
+const ResultView = ({
+  result,
+  input,
+  matchStrings,
+}: {
+  result: TestResult;
+  input: string;
+  matchStrings: string[];
+}) => {
+  const { t, i18n } = useTranslation();
+  const blocked = result.would_block;
+
+  return (
+    <Stack gap="md">
+      <Group gap="sm" wrap="nowrap">
+        <ThemeIcon size={44} radius="xl" variant="light" color={blocked ? 'red' : 'teal'}>
+          {blocked ? <IconX width={26} height={26} /> : <IconCheck width={26} height={26} />}
+        </ThemeIcon>
+        <Text fw={700} size="xl" c={blocked ? 'red' : 'teal'}>
+          {blocked ? t('kiro.tester.verdict.blocked') : t('kiro.tester.verdict.allowed')}
+        </Text>
+      </Group>
+
+      {!result.guard_enabled && (
+        <Alert color="yellow" variant="light" icon={<IconAlert width={18} height={18} />}>
+          {t('kiro.tester.guardDisabled')}
+        </Alert>
+      )}
+
+      <Text size="sm" c="dimmed">
+        {t('kiro.tester.rulesChecked', { count: fmtNumber(result.rules_checked, i18n.language) })}
+      </Text>
+
+      {result.matches.length > 0 && (
+        <Stack gap={6}>
+          <Text size="sm" fw={600}>
+            {t('kiro.tester.matchesTitle')}
+          </Text>
+          {result.matches.map((m) => (
+            <Group key={m.id} gap="xs" wrap="nowrap">
+              <Badge color="red" variant="light" radius="sm">
+                {m.label}
+              </Badge>
+              {m.match && (
+                <Mark color="red">
+                  <Text span size="sm" ff="monospace">
+                    {m.match}
+                  </Text>
+                </Mark>
+              )}
+            </Group>
+          ))}
+        </Stack>
+      )}
+
+      <Stack gap={6}>
+        <Text size="sm" fw={600}>
+          {t('kiro.tester.inputTitle')}
+        </Text>
+        <Card withBorder radius="sm" bg="var(--mantine-color-default-hover)">
+          <Highlight
+            component="div"
+            size="sm"
+            ff="monospace"
+            highlight={matchStrings}
+            style={{ whiteSpace: 'pre-wrap', wordBreak: 'break-word' }}
+          >
+            {input || t('kiro.tester.emptyInput')}
+          </Highlight>
+        </Card>
+      </Stack>
+    </Stack>
+  );
+};
