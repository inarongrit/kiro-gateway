+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+/** Right-side drawer to add or edit a single block rule. */
+import {
+  Alert,
+  Button,
+  Checkbox,
+  Drawer,
+  Group,
+  Loader,
+  Mark,
+  Stack,
+  Switch,
+  Text,
+  Textarea,
+  TextInput,
+} from '@mantine/core';
+import { useDebouncedValue } from '@mantine/hooks';
+import { Fragment, useEffect, useMemo, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+
+import IconCheck from '~icons/tabler/circle-check';
+import IconX from '~icons/tabler/circle-x';
+
+import { checkPattern, type GuardPath, type Rule, slugify } from '../api';
+import { uniqueId } from './draft';
+
+const EMPTY = {
+  label: '',
+  description: '',
+  pattern: '',
+  case_insensitive: false,
+  applies_to: ['kiro', 'ai'] as GuardPath[],
+  enabled: true,
+};
+
+/** Highlight pattern matches in the sample text using the JS regex engine (preview only). */
+const Preview = ({ pattern, caseInsensitive, text }: { pattern: string; caseInsensitive: boolean; text: string }) => {
+  const parts = useMemo(() => {
+    if (!pattern || !text) return null;
+    let re: RegExp;
+    try {
+      re = new RegExp(pattern, caseInsensitive ? 'gi' : 'g');
+    } catch {
+      return null; // Not valid JS regex (e.g. PCRE-only syntax) — no preview.
+    }
+    const out: { text: string; hit: boolean }[] = [];
+    let last = 0;
+    for (const m of text.matchAll(re)) {
+      const i = m.index ?? 0;
+      if (!m[0]) break; // avoid zero-width infinite loop
+      if (i > last) out.push({ text: text.slice(last, i), hit: false });
+      out.push({ text: m[0], hit: true });
+      last = i + m[0].length;
+    }
+    if (last < text.length) out.push({ text: text.slice(last), hit: false });
+    return out;
+  }, [pattern, caseInsensitive, text]);
+
+  const { t } = useTranslation();
+  if (!text) return null;
+  if (!parts) return <Text size="xs" c="dimmed">{t('kiro.rules.preview.noPreview')}</Text>;
+  const anyHit = parts.some((p) => p.hit);
+  return (
+    <Stack gap={4}>
+      <Text size="xs" c="dimmed">
+        {t('kiro.rules.preview.label')}
+      </Text>
+      <Text size="sm" style={{ whiteSpace: 'pre-wrap' }}>
+        {parts.map((p, i) =>
+          p.hit ? (
+            <Mark key={i} color="red">
+              {p.text}
+            </Mark>
+          ) : (
+            <Fragment key={i}>{p.text}</Fragment>
+          )
+        )}
+      </Text>
+      {!anyHit && (
+        <Text size="xs" c="dimmed">
+          {t('kiro.rules.preview.noMatch')}
+        </Text>
+      )}
+    </Stack>
+  );
+};
+
+export type RuleDrawerProps = {
+  opened: boolean;
+  rule: Rule | null; // null = add
+  existing: Rule[]; // current draft rules, to keep ids unique
+  onClose: () => void;
+  onSubmit: (rule: Rule) => void;
+};
+
+export const RuleDrawer = ({ opened, rule, existing, onClose, onSubmit }: RuleDrawerProps) => {
+  const { t } = useTranslation();
+  const [form, setForm] = useState(EMPTY);
+  const [sample, setSample] = useState('');
+  const [check, setCheck] = useState<{ valid: boolean; error: string | null } | null>(null);
+  const [checking, setChecking] = useState(false);
+  const [touched, setTouched] = useState(false);
+  const editing = rule != null;
+
+  // Reset the form whenever the drawer opens for a different rule.
+  useEffect(() => {
+    if (!opened) return;
+    setForm(
+      rule
+        ? {
+            label: rule.label,
+            description: rule.description ?? '',
+            pattern: rule.pattern,
+            case_insensitive: rule.case_insensitive,
+            applies_to: [...rule.applies_to],
+            enabled: rule.enabled,
+          }
+        : EMPTY
+    );
+    setSample('');
+    setCheck(null);
+    setTouched(false);
+  }, [opened, rule]);
+
+  const [debounced] = useDebouncedValue(form.pattern, 400);
+  useEffect(() => {
+    if (!opened || !debounced) {
+      setCheck(null);
+      setChecking(false);
+      return;
+    }
+    let alive = true;
+    setChecking(true);
+    checkPattern(debounced)
+      .then((r) => alive && setCheck(r))
+      .catch(() => alive && setCheck({ valid: false, error: 'check failed' }))
+      .finally(() => alive && setChecking(false));
+    return () => {
+      alive = false;
+    };
+  }, [debounced, opened]);
+
+  const id = editing
+    ? rule!.id
+    : form.label.trim()
+      ? uniqueId(slugify(form.label), existing)
+      : t('kiro.rules.drawer.idFromName');
+
+  const labelError = touched && !form.label.trim() ? t('kiro.rules.drawer.nameRequired') : null;
+  const patternError = touched && !form.pattern ? t('kiro.rules.drawer.patternRequired') : null;
+  const appliesError = touched && form.applies_to.length === 0 ? t('kiro.rules.drawer.appliesRequired') : null;
+  const invalid =
+    !form.label.trim() || !form.pattern || form.applies_to.length === 0 || check?.valid === false || checking;
+
+  const toggleApplies = (p: GuardPath, on: boolean) =>
+    setForm((f) => ({
+      ...f,
+      applies_to: on ? [...new Set([...f.applies_to, p])] : f.applies_to.filter((x) => x !== p),
+    }));
+
+  const submit = () => {
+    setTouched(true);
+    if (invalid) return;
+    onSubmit({
+      id,
+      label: form.label.trim(),
+      description: form.description.trim(),
+      pattern: form.pattern,
+      case_insensitive: form.case_insensitive,
+      applies_to: form.applies_to,
+      enabled: form.enabled,
+    });
+  };
+
+  return (
+    <Drawer
+      opened={opened}
+      onClose={onClose}
+      position="right"
+      size="lg"
+      title={editing ? t('kiro.rules.drawer.editTitle') : t('kiro.rules.drawer.addTitle')}
+    >
+      <Stack>
+        <TextInput
+          label={t('kiro.rules.drawer.name')}
+          placeholder={t('kiro.rules.drawer.namePlaceholder')}
+          value={form.label}
+          error={labelError}
+          onChange={(e) => setForm((f) => ({ ...f, label: e.currentTarget.value }))}
+        />
+        <TextInput label={t('kiro.rules.drawer.id')} value={id} readOnly ff="monospace" />
+        <Textarea
+          label={t('kiro.rules.drawer.description')}
+          placeholder={t('kiro.rules.drawer.descriptionPlaceholder')}
+          autosize
+          minRows={2}
+          value={form.description}
+          onChange={(e) => setForm((f) => ({ ...f, description: e.currentTarget.value }))}
+        />
+        <Textarea
+          label={t('kiro.rules.drawer.pattern')}
+          description={t('kiro.rules.drawer.patternHint')}
+          placeholder={t('kiro.rules.drawer.patternPlaceholder')}
+          autosize
+          minRows={2}
+          error={patternError}
+          styles={{ input: { fontFamily: 'monospace' } }}
+          value={form.pattern}
+          onChange={(e) => setForm((f) => ({ ...f, pattern: e.currentTarget.value }))}
+        />
+        {form.pattern &&
+          (checking ? (
+            <Group gap={6}>
+              <Loader size="xs" />
+              <Text size="xs" c="dimmed">
+                {t('kiro.rules.drawer.checking')}
+              </Text>
+            </Group>
+          ) : check ? (
+            check.valid ? (
+              <Group gap={6} c="teal">
+                <IconCheck width={16} height={16} />
+                <Text size="xs">{t('kiro.rules.drawer.patternValid')}</Text>
+              </Group>
+            ) : (
+              <Group gap={6} c="red">
+                <IconX width={16} height={16} />
+                <Text size="xs">{check.error ?? t('kiro.rules.drawer.patternInvalid')}</Text>
+              </Group>
+            )
+          ) : null)}
+        <Switch
+          label={t('kiro.rules.drawer.caseInsensitive')}
+          checked={form.case_insensitive}
+          onChange={(e) => setForm((f) => ({ ...f, case_insensitive: e.currentTarget.checked }))}
+        />
+        <Checkbox.Group
+          label={t('kiro.rules.drawer.appliesTo')}
+          error={appliesError}
+          value={form.applies_to}
+        >
+          <Group mt={6} gap="lg">
+            <Checkbox
+              value="kiro"
+              label={t('kiro.guard.path.kiro')}
+              checked={form.applies_to.includes('kiro')}
+              onChange={(e) => toggleApplies('kiro', e.currentTarget.checked)}
+            />
+            <Checkbox
+              value="ai"
+              label={t('kiro.guard.path.ai')}
+              checked={form.applies_to.includes('ai')}
+              onChange={(e) => toggleApplies('ai', e.currentTarget.checked)}
+            />
+          </Group>
+        </Checkbox.Group>
+        <Switch
+          label={t('kiro.rules.drawer.enabled')}
+          checked={form.enabled}
+          onChange={(e) => setForm((f) => ({ ...f, enabled: e.currentTarget.checked }))}
+        />
+
+        <Alert color="gray" variant="light" title={t('kiro.rules.tryIt.title')}>
+          <Stack gap="xs">
+            <Text size="xs" c="dimmed">
+              {t('kiro.rules.tryIt.note')}
+            </Text>
+            <Textarea
+              label={t('kiro.rules.tryIt.sample')}
+              placeholder={t('kiro.rules.tryIt.samplePlaceholder')}
+              autosize
+              minRows={2}
+              value={sample}
+              onChange={(e) => setSample(e.currentTarget.value)}
+            />
+            <Preview pattern={form.pattern} caseInsensitive={form.case_insensitive} text={sample} />
+          </Stack>
+        </Alert>
+
+        <Group justify="flex-end" mt="sm">
+          <Button variant="default" onClick={onClose}>
+            {t('kiro.rules.drawer.cancel')}
+          </Button>
+          <Button onClick={submit}>{t('kiro.rules.drawer.save')}</Button>
+        </Group>
+      </Stack>
+    </Drawer>
+  );
+};
