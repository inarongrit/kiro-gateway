+ * contributor license agreements.  See the NOTICE file distributed with
+ * this work for additional information regarding copyright ownership.
+ * The ASF licenses this file to You under the Apache License, Version 2.0
+ * (the "License"); you may not use this file except in compliance with
+ * the License.  You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+import {
+  Box,
+  Button,
+  Card,
+  Center,
+  Checkbox,
+  Group,
+  SegmentedControl,
+  Select,
+  Table,
+  Text,
+  TextInput,
+  Tooltip,
+  UnstyledButton,
+} from '@mantine/core';
+import { useDebouncedValue } from '@mantine/hooks';
+import { useState } from 'react';
+import { useTranslation } from 'react-i18next';
+
+import { PortalPageHeader } from '@/kiro/shell/Page';
+import IconPause from '~icons/tabler/player-pause';
+import IconPlay from '~icons/tabler/player-play';
+import IconSearch from '~icons/tabler/search';
+
+import type { AuditEvent, EventResult, GuardPath } from '../api';
+import { useEvents } from '../api';
+import { fmtMs, fmtTime, useRuleLabel, useTimeAgo } from '../format';
+import { EmptyState, ErrorState, LoadingState, PathBadge, ResultBadge } from '../ui';
+import { ActivityDrawer } from './ActivityDrawer';
+import { userText } from './userText';
+
+const DEFAULT_LIMIT = 200;
+const EXPANDED_LIMIT = 1000;
+
+const HOURS_BY_WINDOW: Record<string, number> = { '1h': 1, '24h': 24, '7d': 168, '30d': 720 };
+
+export const ActivityPage = () => {
+  const { t, i18n } = useTranslation();
+  const ruleLabel = useRuleLabel();
+  const timeAgo = useTimeAgo();
+
+  const [search, setSearch] = useState('');
+  const [debouncedSearch] = useDebouncedValue(search, 300);
+  const [result, setResult] = useState<'' | EventResult>('');
+  const [path, setPath] = useState<'' | GuardPath>('');
+  const [window, setWindow] = useState('24h');
+  const [allOps, setAllOps] = useState(false);
+  const [live, setLive] = useState(true);
+  const [limit, setLimit] = useState(DEFAULT_LIMIT);
+  const [selected, setSelected] = useState<AuditEvent | null>(null);
+
+  const { data, isLoading, isError, error } = useEvents(
+    {
+      q: debouncedSearch || undefined,
+      result: result || undefined,
+      path: path || undefined,
+      hours: HOURS_BY_WINDOW[window],
+      all_ops: allOps || undefined,
+      limit,
+    },
+    live,
+  );
+
+  const events = data ?? [];
+  const canShowMore = limit === DEFAULT_LIMIT && events.length >= DEFAULT_LIMIT;
+
+  const resultOptions = [
+    { value: '', label: t('kiro.activity.filter.resultAll') },
+    { value: 'allowed', label: t('kiro.guard.result.allowed') },
+    { value: 'blocked', label: t('kiro.guard.result.blocked') },
+    { value: 'rate_limited', label: t('kiro.guard.result.rate_limited') },
+    { value: 'error', label: t('kiro.guard.result.error') },
+  ];
+
+  const header = (
+    <PortalPageHeader
+      title={t('kiro.activity.title')}
+      subtitle={t('kiro.activity.subtitle')}
+      actions={
+        <Button
+          onClick={() => setLive((v) => !v)}
+          size="xs"
+          radius="sm"
+          variant={live ? 'filled' : 'light'}
+          color={live ? 'teal' : 'gray'}
+          leftSection={live ? <IconPause width={14} height={14} /> : <IconPlay width={14} height={14} />}
+          aria-label={live ? t('kiro.activity.live.pause') : t('kiro.activity.live.resume')}
+        >
+          {live ? t('kiro.activity.live.on') : t('kiro.activity.live.paused')}
+        </Button>
+      }
+    />
+  );
+
+  const filterBar = (
+    <Group gap="sm" mb="md" align="flex-end" wrap="wrap">
+      <TextInput
+        label={t('kiro.activity.filter.search')}
+        placeholder={t('kiro.activity.filter.searchPlaceholder')}
+        value={search}
+        onChange={(e) => setSearch(e.currentTarget.value)}
+        leftSection={<IconSearch width={16} height={16} />}
+        w={240}
+      />
+      <Box>
+        <Text size="sm" fw={500} mb={4}>
+          {t('kiro.activity.filter.result')}
+        </Text>
+        <SegmentedControl
+          size="xs"
+          value={result}
+          onChange={(v) => setResult(v as '' | EventResult)}
+          data={resultOptions}
+        />
+      </Box>
+      <Select
+        label={t('kiro.activity.filter.path')}
+        value={path}
+        onChange={(v) => setPath((v ?? '') as '' | GuardPath)}
+        w={160}
+        allowDeselect={false}
+        data={[
+          { value: '', label: t('kiro.activity.filter.pathAll') },
+          { value: 'kiro', label: t('kiro.guard.path.kiro') },
+          { value: 'ai', label: t('kiro.guard.path.ai') },
+        ]}
+      />
+      <Select
+        label={t('kiro.activity.filter.window')}
+        value={window}
+        onChange={(v) => setWindow(v ?? '24h')}
+        w={140}
+        allowDeselect={false}
+        data={[
+          { value: '1h', label: t('kiro.activity.filter.window1h') },
+          { value: '24h', label: t('kiro.activity.filter.window24h') },
+          { value: '7d', label: t('kiro.activity.filter.window7d') },
+          { value: '30d', label: t('kiro.activity.filter.window30d') },
+        ]}
+      />
+      <Checkbox
+        label={t('kiro.activity.filter.allOps')}
+        checked={allOps}
+        onChange={(e) => setAllOps(e.currentTarget.checked)}
+        mb={6}
+      />
+    </Group>
+  );
+
+  const body = () => {
+    if (isLoading && !data) return <LoadingState />;
+    if (isError) return <ErrorState error={error} />;
+    if (!events.length)
+      return <EmptyState title={t('kiro.activity.empty.title')} body={t('kiro.activity.empty.body')} />;
+
+    return (
+      <Table.ScrollContainer minWidth={960}>
+        <Table striped highlightOnHover stickyHeader>
+          <Table.Thead>
+            <Table.Tr>
+              <Table.Th>{t('kiro.activity.col.time')}</Table.Th>
+              <Table.Th>{t('kiro.activity.col.result')}</Table.Th>
+              <Table.Th>{t('kiro.activity.col.rule')}</Table.Th>
+              <Table.Th>{t('kiro.activity.col.path')}</Table.Th>
+              <Table.Th>{t('kiro.activity.col.user')}</Table.Th>
+              <Table.Th>{t('kiro.activity.col.prompt')}</Table.Th>
+              <Table.Th>{t('kiro.activity.col.latency')}</Table.Th>
+            </Table.Tr>
+          </Table.Thead>
+          <Table.Tbody>
+            {events.map((ev, i) => (
+              <Table.Tr
+                key={`${ev.ts}-${ev.user}-${i}`}
+                onClick={() => setSelected(ev)}
+                style={{ cursor: 'pointer' }}
+              >
+                <Table.Td>
+                  <Tooltip label={fmtTime(ev.ts, i18n.language)} withArrow>
+                    <Text size="sm">{timeAgo(ev.ts)}</Text>
+                  </Tooltip>
+                </Table.Td>
+                <Table.Td>
+                  <ResultBadge result={ev.result} />
+                </Table.Td>
+                <Table.Td>
+                  <Text size="sm">{ruleLabel(ev.rule) || '–'}</Text>
+                </Table.Td>
+                <Table.Td>
+                  <PathBadge path={ev.path} />
+                </Table.Td>
+                <Table.Td>
+                  <Text size="sm" ff="monospace">
+                    {ev.user}
+                  </Text>
+                </Table.Td>
+                <Table.Td style={{ maxWidth: 360 }}>
+                  {ev.path === 'ai' ? (
+                    <Text size="sm" c="dimmed" fs="italic" truncate>
+                      {t('kiro.activity.notStored')}
+                    </Text>
+                  ) : (
+                    <Text size="sm" truncate>
+                      {userText(ev.prompt).replace(/\s+/g, ' ').trim() || '–'}
+                    </Text>
+                  )}
+                </Table.Td>
+                <Table.Td>
+                  <Text size="sm">{fmtMs(ev.latency_ms)}</Text>
+                </Table.Td>
+              </Table.Tr>
+            ))}
+          </Table.Tbody>
+        </Table>
+      </Table.ScrollContainer>
+    );
+  };
+
+  return (
+    <Box maw={1440}>
+      {header}
+      <Card withBorder>
+        {filterBar}
+        {body()}
+        {canShowMore && (
+          <Center mt="md">
+            <UnstyledButton onClick={() => setLimit(EXPANDED_LIMIT)}>
+              <Text size="sm" c="blue" fw={500}>
+                {t('kiro.activity.showMore')}
+              </Text>
+            </UnstyledButton>
+          </Center>
+        )}
+      </Card>
+      <ActivityDrawer event={selected} onClose={() => setSelected(null)} />
+    </Box>
+  );
+};
