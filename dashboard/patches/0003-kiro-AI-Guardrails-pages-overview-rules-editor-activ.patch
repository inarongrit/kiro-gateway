+/** Table of block rules, one row per rule, checked top to bottom. */
+import { ActionIcon, Badge, Code, Group, Menu, Stack, Switch, Table, Text, Tooltip } from '@mantine/core';
+import type { FC } from 'react';
+import { useTranslation } from 'react-i18next';
+
+import IconDown from '~icons/tabler/arrow-down';
+import IconUp from '~icons/tabler/arrow-up';
+import IconDots from '~icons/tabler/dots-vertical';
+import IconEdit from '~icons/tabler/edit';
+import IconTrash from '~icons/tabler/trash';
+
+import type { Rule } from '../api';
+import { PathBadge } from '../ui';
+
+export type RulesTableProps = {
+  rules: Rule[];
+  onToggle: (id: string, enabled: boolean) => void;
+  onEdit: (rule: Rule) => void;
+  onMove: (id: string, dir: -1 | 1) => void;
+  onDelete: (rule: Rule) => void;
+};
+
+export const RulesTable: FC<RulesTableProps> = ({ rules, onToggle, onEdit, onMove, onDelete }) => {
+  const { t } = useTranslation();
+  return (
+    <Table.ScrollContainer minWidth={720}>
+      <Table verticalSpacing="sm" highlightOnHover>
+        <Table.Thead>
+          <Table.Tr>
+            <Table.Th w={60}>{t('kiro.rules.table.on')}</Table.Th>
+            <Table.Th w={56}>{t('kiro.rules.table.order')}</Table.Th>
+            <Table.Th>{t('kiro.rules.table.rule')}</Table.Th>
+            <Table.Th>{t('kiro.rules.table.pattern')}</Table.Th>
+            <Table.Th>{t('kiro.rules.table.appliesTo')}</Table.Th>
+            <Table.Th w={56} ta="right">
+              {t('kiro.rules.table.actions')}
+            </Table.Th>
+          </Table.Tr>
+        </Table.Thead>
+        <Table.Tbody>
+          {rules.map((r, i) => (
+            <Table.Tr key={r.id} opacity={r.enabled ? 1 : 0.55}>
+              <Table.Td>
+                <Switch
+                  size="sm"
+                  aria-label={t('kiro.rules.table.toggleAria', { label: r.label })}
+                  checked={r.enabled}
+                  onChange={(e) => onToggle(r.id, e.currentTarget.checked)}
+                />
+              </Table.Td>
+              <Table.Td>
+                <Text size="sm" c="dimmed">
+                  {i + 1}
+                </Text>
+              </Table.Td>
+              <Table.Td>
+                <Stack gap={2}>
+                  <Group gap={6} wrap="wrap">
+                    <Text size="sm" fw={500}>
+                      {r.label}
+                    </Text>
+                    <Code fz="xs">{r.id}</Code>
+                    {r.case_insensitive && (
+                      <Badge size="xs" variant="light" color="gray">
+                        {t('kiro.rules.table.anyCase')}
+                      </Badge>
+                    )}
+                  </Group>
+                  {r.description && (
+                    <Text size="xs" c="dimmed">
+                      {r.description}
+                    </Text>
+                  )}
+                </Stack>
+              </Table.Td>
+              <Table.Td>
+                <Tooltip label={r.pattern} multiline maw={420} withArrow>
+                  <Code fz="xs" style={{ maxWidth: 220, display: 'inline-block', overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap', verticalAlign: 'bottom' }}>
+                    {r.pattern}
+                  </Code>
+                </Tooltip>
+              </Table.Td>
+              <Table.Td>
+                <Group gap={4}>
+                  {r.applies_to.map((p) => (
+                    <PathBadge key={p} path={p} />
+                  ))}
+                </Group>
+              </Table.Td>
+              <Table.Td ta="right">
+                <Menu position="bottom-end" withinPortal>
+                  <Menu.Target>
+                    <ActionIcon variant="subtle" color="gray" aria-label={t('kiro.rules.table.actionsAria', { label: r.label })}>
+                      <IconDots width={18} height={18} />
+                    </ActionIcon>
+                  </Menu.Target>
+                  <Menu.Dropdown>
+                    <Menu.Item leftSection={<IconEdit width={16} height={16} />} onClick={() => onEdit(r)}>
+                      {t('kiro.rules.table.edit')}
+                    </Menu.Item>
+                    <Menu.Item
+                      leftSection={<IconUp width={16} height={16} />}
+                      disabled={i === 0}
+                      onClick={() => onMove(r.id, -1)}
+                    >
+                      {t('kiro.rules.table.moveUp')}
+                    </Menu.Item>
+                    <Menu.Item
+                      leftSection={<IconDown width={16} height={16} />}
+                      disabled={i === rules.length - 1}
+                      onClick={() => onMove(r.id, 1)}
+                    >
+                      {t('kiro.rules.table.moveDown')}
+                    </Menu.Item>
+                    <Menu.Divider />
+                    <Menu.Item color="red" leftSection={<IconTrash width={16} height={16} />} onClick={() => onDelete(r)}>
+                      {t('kiro.rules.table.delete')}
+                    </Menu.Item>
+                  </Menu.Dropdown>
+                </Menu>
+              </Table.Td>
+            </Table.Tr>
+          ))}
+        </Table.Tbody>
+      </Table>
+    </Table.ScrollContainer>
+  );
+};
