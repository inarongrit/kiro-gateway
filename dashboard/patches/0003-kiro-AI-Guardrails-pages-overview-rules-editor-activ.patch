+/**
+ * Licensed to the Apache Software Foundation (ASF) under one or more
+ * contributor license agreements.  See the NOTICE file distributed with
+ * this work for additional information regarding copyright ownership.
+ * The ASF licenses this file to You under the Apache License, Version 2.0
+ * (the "License"); you may not use this file except in compliance with
+ * the License.  You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+/** Local draft of the guardrail config and the diff between saved and draft. */
+import type { GuardrailConfig, GuardrailSwitches, Rule } from '../api';
+
+/** Deep clone the editable part of the config so edits never mutate the query cache. */
+export const cloneConfig = (c: GuardrailConfig): GuardrailConfig => ({
+  block_message: c.block_message,
+  rules: c.rules.map((r) => ({ ...r, applies_to: [...r.applies_to] })),
+  guardrails: {
+    kiro_prompt_guard: { ...c.guardrails.kiro_prompt_guard },
+    kiro_rate_limit: { ...c.guardrails.kiro_rate_limit },
+    ai_prompt_guard: { ...c.guardrails.ai_prompt_guard },
+    ai_token_budget: { ...c.guardrails.ai_token_budget },
+  },
+});
+
+/** A unique rule id derived from a slug base, avoiding ids already used in the draft. */
+export const uniqueId = (base: string, rules: Rule[]) => {
+  const seed = base || 'rule';
+  let id = seed;
+  let i = 2;
+  while (rules.some((r) => r.id === id)) id = `${seed}-${i++}`;
+  return id;
+};
+
+export type RuleFieldChange = { field: string; from: unknown; to: unknown };
+
+export type RuleDiff =
+  | { kind: 'added'; id: string; label: string }
+  | { kind: 'removed'; id: string; label: string }
+  | { kind: 'reordered'; id: string; label: string; from: number; to: number }
+  | { kind: 'changed'; id: string; label: string; fields: RuleFieldChange[] };
+
+export type SwitchDiff = { key: keyof GuardrailSwitches; fields: RuleFieldChange[] };
+
+export type ConfigDiff = {
+  rules: RuleDiff[];
+  switches: SwitchDiff[];
+  blockMessage: { from: string; to: string } | null;
+};
+
+const RULE_FIELDS: (keyof Rule)[] = [
+  'label',
+  'description',
+  'pattern',
+  'case_insensitive',
+  'applies_to',
+  'enabled',
+];
+
+const sameValue = (a: unknown, b: unknown) =>
+  Array.isArray(a) && Array.isArray(b) ? JSON.stringify(a) === JSON.stringify(b) : a === b;
+
+/** Human-readable list of what changed between the saved config and the draft. */
+export const diffConfig = (saved: GuardrailConfig, draft: GuardrailConfig): ConfigDiff => {
+  const savedById = new Map(saved.rules.map((r) => [r.id, r]));
+  const draftById = new Map(draft.rules.map((r) => [r.id, r]));
+  const savedOrder = new Map(saved.rules.map((r, i) => [r.id, i]));
+
+  const rules: RuleDiff[] = [];
+  for (const r of draft.rules) {
+    const prev = savedById.get(r.id);
+    if (!prev) {
+      rules.push({ kind: 'added', id: r.id, label: r.label });
+      continue;
+    }
+    const fields: RuleFieldChange[] = [];
+    for (const f of RULE_FIELDS) {
+      if (!sameValue(prev[f], r[f])) fields.push({ field: f, from: prev[f], to: r[f] });
+    }
+    if (fields.length) rules.push({ kind: 'changed', id: r.id, label: r.label, fields });
+  }
+  for (const r of saved.rules) {
+    if (!draftById.has(r.id)) rules.push({ kind: 'removed', id: r.id, label: r.label });
+  }
+  // Order changes among rules present in both, with no field changes already listed.
+  const common = draft.rules.filter((r) => savedById.has(r.id));
+  common.forEach((r, newIdx) => {
+    const oldIdx = savedOrder.get(r.id)!;
+    const alreadyListed = rules.some((d) => d.id === r.id && d.kind !== 'reordered');
+    // Compare position within the common subsequence to detect genuine reorder.
+    const oldCommon = saved.rules.filter((s) => draftById.has(s.id)).findIndex((s) => s.id === r.id);
+    if (oldCommon !== newIdx && !alreadyListed) {
+      rules.push({ kind: 'reordered', id: r.id, label: r.label, from: oldIdx, to: newIdx });
+    }
+  });
+
+  const switches: SwitchDiff[] = [];
+  (Object.keys(draft.guardrails) as (keyof GuardrailSwitches)[]).forEach((key) => {
+    const a = saved.guardrails[key] as Record<string, unknown>;
+    const b = draft.guardrails[key] as Record<string, unknown>;
+    const fields: RuleFieldChange[] = [];
+    Object.keys(b).forEach((k) => {
+      if (!sameValue(a[k], b[k])) fields.push({ field: k, from: a[k], to: b[k] });
+    });
+    if (fields.length) switches.push({ key, fields });
+  });
+
+  return {
+    rules,
+    switches,
+    blockMessage:
+      saved.block_message !== draft.block_message
+        ? { from: saved.block_message, to: draft.block_message }
+        : null,
+  };
+};
+
+/** Count of distinct user-visible changes, for the sticky bar. */
+export const countChanges = (d: ConfigDiff) =>
+  d.rules.length + d.switches.length + (d.blockMessage ? 1 : 0);
