+/** Change history card: recent git commits of the rules file. */
+import { Code, Group, Skeleton, Stack, Text } from '@mantine/core';
+import type { FC } from 'react';
+import { useTranslation } from 'react-i18next';
+
+import { useHistory } from '../api';
+import { fmtTime, useTimeAgo } from '../format';
+import { EmptyState, ErrorState, SectionCard } from '../ui';
+
+export const HistoryCard: FC = () => {
+  const { t, i18n } = useTranslation();
+  const { data, isLoading, error } = useHistory();
+  const timeAgo = useTimeAgo();
+
+  return (
+    <SectionCard title={t('kiro.rules.history.title')} hint={t('kiro.rules.history.hint')}>
+      {isLoading ? (
+        <Stack gap="sm">
+          {[0, 1, 2].map((i) => (
+            <Skeleton key={i} h={44} radius="sm" />
+          ))}
+        </Stack>
+      ) : error ? (
+        <ErrorState error={error} />
+      ) : !data || data.length === 0 ? (
+        <EmptyState title={t('kiro.rules.history.emptyTitle')} body={t('kiro.rules.history.emptyBody')} />
+      ) : (
+        <Stack gap="sm">
+          {data.map((c) => (
+            <Group key={c.commit} gap="sm" wrap="nowrap" align="flex-start">
+              <Code>{c.commit}</Code>
+              <Stack gap={0} style={{ flex: 1 }}>
+                <Text size="sm">{c.summary.replace(/^guardrails:\s*/, '')}</Text>
+                <Text size="xs" c="dimmed" title={fmtTime(c.time, i18n.language)}>
+                  {timeAgo(c.time)} · {c.author}
+                </Text>
+              </Stack>
+            </Group>
+          ))}
+        </Stack>
+      )}
+    </SectionCard>
+  );
+};
