+/** The prominent "N of M prompts passed every guardrail" summary with a status ring. */
+import { Card, Group, RingProgress, Skeleton, Stack, Text } from '@mantine/core';
+import type { FC } from 'react';
+import { Trans, useTranslation } from 'react-i18next';
+
+import type { Stats } from '../api';
+import { fmtNumber } from '../format';
+import { passedCount } from './data';
+
+export const SummaryHero: FC<{ stats?: Stats; loading?: boolean }> = ({ stats, loading }) => {
+  const { t, i18n } = useTranslation();
+
+  if (loading || !stats) {
+    return (
+      <Card withBorder>
+        <Group justify="space-between" wrap="nowrap">
+          <Stack gap={8} flex={1}>
+            <Skeleton height={28} width="60%" radius="sm" />
+            <Skeleton height={14} width="40%" radius="sm" />
+          </Stack>
+          <Skeleton circle height={92} />
+        </Group>
+      </Card>
+    );
+  }
+
+  const passed = passedCount(stats);
+  const pct = stats.requests > 0 ? (passed / stats.requests) * 100 : 100;
+  const ringColor = pct >= 95 ? 'teal' : pct >= 80 ? 'yellow' : 'red';
+
+  return (
+    <Card withBorder>
+      <Group justify="space-between" align="center" wrap="nowrap" gap="xl">
+        <Stack gap={6}>
+          <Text fz={24} fw={650} lh={1.2} style={{ fontVariantNumeric: 'tabular-nums' }}>
+            <Trans
+              i18nKey="kiro.overview.summary.line"
+              t={t}
+              values={{ passed: fmtNumber(passed, i18n.language), total: fmtNumber(stats.requests, i18n.language) }}
+              components={{ b: <Text span inherit c="teal" /> }}
+            />
+          </Text>
+          <Group gap="lg">
+            <Text size="sm" c="dimmed">
+              {t('kiro.overview.summary.blocked', { count: stats.blocked })}
+            </Text>
+            <Text size="sm" c="dimmed">
+              {t('kiro.overview.summary.rateLimited', { count: stats.rate_limited })}
+            </Text>
+          </Group>
+        </Stack>
+        <RingProgress
+          size={92}
+          thickness={9}
+          roundCaps
+          sections={[{ value: pct, color: ringColor }]}
+          label={
+            <Text ta="center" fw={700} fz="sm" style={{ fontVariantNumeric: 'tabular-nums' }}>
+              {pct.toFixed(pct >= 99.95 ? 0 : 1)}%
+            </Text>
+          }
+          aria-label={t('kiro.overview.summary.ringAria', { pct: pct.toFixed(1) })}
+        />
+      </Group>
+    </Card>
+  );
+};
diff --git a/src/kiro/guardrails/overview/data.ts b/src/kiro/guardrails/overview/data.ts
