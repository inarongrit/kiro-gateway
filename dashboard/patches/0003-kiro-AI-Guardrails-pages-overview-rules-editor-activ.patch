+/** Latest guardrail events as a compact feed, with a link to the full activity page. */
+import { Anchor, Badge, Group, Skeleton, Stack, Text } from '@mantine/core';
+import { Link } from '@tanstack/react-router';
+import type { FC } from 'react';
+import { useTranslation } from 'react-i18next';
+
+import { useEvents } from '../api';
+import { useRuleLabel, useTimeAgo } from '../format';
+import { EmptyState, ErrorState, ResultBadge, SectionCard } from '../ui';
+import type { RangeHours } from './data';
+
+/** Kiro wraps the user's words in context blocks; show just the user message. */
+const userText = (s: string): string => {
+  const m = /--- USER MESSAGE BEGIN ---\s*([\s\S]*?)\s*(--- USER MESSAGE END ---|$)/.exec(s);
+  return (m && m[1] ? m[1] : s).trim();
+};
+
+export const LiveActivity: FC<{ hours: RangeHours }> = ({ hours }) => {
+  const { t } = useTranslation();
+  const ruleLabel = useRuleLabel();
+  const timeAgo = useTimeAgo();
+  const { data: events, isPending, error } = useEvents({ hours, limit: 8 });
+
+  const action = (
+    <Anchor component={Link} to="/guardrails/activity" size="sm">
+      {t('kiro.overview.activity.viewAll')}
+    </Anchor>
+  );
+
+  return (
+    <SectionCard
+      title={
+        <Group gap="xs">
+          {t('kiro.overview.activity.title')}
+          <Badge color="teal" variant="dot" size="sm">
+            {t('kiro.overview.activity.live')}
+          </Badge>
+        </Group>
+      }
+      action={action}
+    >
+      {isPending ? (
+        <Stack gap="sm">
+          {Array.from({ length: 5 }).map((_, i) => (
+            <Skeleton key={i} height={20} radius="sm" />
+          ))}
+        </Stack>
+      ) : error ? (
+        <ErrorState error={error} />
+      ) : events.length === 0 ? (
+        <EmptyState title={t('kiro.overview.activity.empty')} />
+      ) : (
+        <Stack gap={0}>
+          {events.map((e, i) => (
+            <Group
+              key={`${e.ts}-${i}`}
+              gap="sm"
+              wrap="nowrap"
+              align="center"
+              py={9}
+              style={i > 0 ? { borderTop: '1px solid var(--mantine-color-default-border)' } : undefined}
+            >
+              <Text size="xs" c="dimmed" w={104} style={{ flex: 'none', whiteSpace: 'nowrap' }}>
+                {timeAgo(e.ts)}
+              </Text>
+              <ResultBadge result={e.result} />
+              <Text size="sm" truncate flex={1}>
+                {userText(e.prompt) || t('kiro.overview.activity.noPrompt')}
+              </Text>
+              <Text size="xs" c="dimmed" style={{ flex: 'none' }}>
+                {ruleLabel(e.rule) ? `${ruleLabel(e.rule)} · ` : ''}
+                <Text span ff="monospace">
+                  {e.user}
+                </Text>
+              </Text>
+            </Group>
+          ))}
+        </Stack>
+      )}
+    </SectionCard>
+  );
+};
