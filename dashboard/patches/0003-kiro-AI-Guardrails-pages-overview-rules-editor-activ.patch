+ * contributor license agreements.  See the NOTICE file distributed with
+ * this work for additional information regarding copyright ownership.
+ * The ASF licenses this file to You under the Apache License, Version 2.0
+ * (the "License"); you may not use this file except in compliance with
+ * the License.  You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+/** Pure data helpers for the Overview page: time ranges and timeline bucketing. */
+import type { Stats } from '../api';
+
+export type RangeHours = 1 | 24 | 168;
+
+/** The three selectable windows, in hours. */
+export const RANGE_HOURS: RangeHours[] = [1, 24, 168];
+
+/** One point on the allowed/blocked/rate-limited chart. */
+export type SeriesPoint = {
+  date: string;
+  allowed: number;
+  blocked: number;
+  rate_limited: number;
+};
+
+const HOUR_MS = 3_600_000;
+const DAY_MS = 86_400_000;
+
+/** Parse an API bucket ("2026-10-02T07:00", treated as local wall-clock) into epoch ms. */
+const bucketMs = (bucket: string): number => {
+  const d = new Date(bucket.length <= 16 ? `${bucket}:00` : bucket);
+  return d.getTime();
+};
+
+/** Floor an epoch to the start of its hour / day. */
+const floorTo = (ms: number, step: number) => Math.floor(ms / step) * step;
+
+/**
+ * Fold the raw timeline into evenly-spaced buckets across the selected window,
+ * filling gaps with zeros. Hourly for 1h/24h, daily for 7d.
+ */
+export const buildSeries = (
+  timeline: Stats['timeline'],
+  hours: RangeHours,
+  now: number = Date.now()
+): SeriesPoint[] => {
+  const daily = hours === 168;
+  const step = daily ? DAY_MS : HOUR_MS;
+  const count = daily ? 7 : hours;
+  const end = floorTo(now, step);
+  const start = end - (count - 1) * step;
+
+  const buckets = new Map<number, SeriesPoint>();
+  for (let i = 0; i < count; i++) {
+    const ts = start + i * step;
+    buckets.set(ts, {
+      date: new Date(ts).toISOString(),
+      allowed: 0,
+      blocked: 0,
+      rate_limited: 0,
+    });
+  }
+
+  for (const row of timeline) {
+    const key = floorTo(bucketMs(row.bucket), step);
+    const point = buckets.get(key);
+    if (!point) continue;
+    point.allowed += row.allowed ?? 0;
+    point.blocked += row.blocked ?? 0;
+    point.rate_limited += row.rate_limited ?? 0;
+  }
+
+  return [...buckets.values()];
+};
+
+/** Flat per-metric sparkline arrays derived from a series. */
+export const sparkFrom = (series: SeriesPoint[], key: keyof Omit<SeriesPoint, 'date'>): number[] =>
+  series.map((p) => p[key]);
+
+/** passed = requests - blocked - rate_limited, never negative. */
+export const passedCount = (s: Pick<Stats, 'requests' | 'blocked' | 'rate_limited'>): number =>
+  Math.max(0, s.requests - s.blocked - s.rate_limited);
+
+/** Local-time axis label for a bucket; hour-of-day for hourly, short date for daily. */
+export const axisLabel = (iso: string, daily: boolean, lang?: string): string =>
+  daily
+    ? new Intl.DateTimeFormat(lang, { month: 'short', day: 'numeric' }).format(new Date(iso))
+    : new Intl.DateTimeFormat(lang, { hour: '2-digit', minute: '2-digit' }).format(new Date(iso));
