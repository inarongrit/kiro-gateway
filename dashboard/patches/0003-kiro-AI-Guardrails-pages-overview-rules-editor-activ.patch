+/** Modal that previews the draft diff and applies it to the gateway. */
+import { Alert, Badge, Button, Code, Group, List, Modal, Stack, Text } from '@mantine/core';
+import type { FC } from 'react';
+import { useTranslation } from 'react-i18next';
+
+import IconReload from '~icons/tabler/reload';
+
+import type { ConfigDiff, RuleFieldChange } from './draft';
+
+const fmtVal = (v: unknown): string => {
+  if (Array.isArray(v)) return v.join(', ');
+  if (typeof v === 'boolean') return v ? 'on' : 'off';
+  if (v === '' || v == null) return '—';
+  return String(v);
+};
+
+const FieldChange: FC<{ change: RuleFieldChange }> = ({ change }) => {
+  const { t } = useTranslation();
+  const name =
+    {
+      label: t('kiro.rules.field.label'),
+      description: t('kiro.rules.field.description'),
+      pattern: t('kiro.rules.field.pattern'),
+      case_insensitive: t('kiro.rules.field.case_insensitive'),
+      applies_to: t('kiro.rules.field.applies_to'),
+      enabled: t('kiro.rules.field.enabled'),
+      requests: t('kiro.rules.field.requests'),
+      window_seconds: t('kiro.rules.field.window_seconds'),
+      tokens: t('kiro.rules.field.tokens'),
+    }[String(change.field)] ?? String(change.field);
+  return (
+    <Text size="sm">
+      {name}: <Code>{fmtVal(change.from)}</Code> → <Code>{fmtVal(change.to)}</Code>
+    </Text>
+  );
+};
+
+export type ReviewModalProps = {
+  opened: boolean;
+  diff: ConfigDiff;
+  count: number;
+  saving: boolean;
+  conflict: boolean;
+  error: string | null;
+  onClose: () => void;
+  onApply: () => void;
+  onReload: () => void;
+};
+
+export const ReviewModal: FC<ReviewModalProps> = ({
+  opened,
+  diff,
+  count,
+  saving,
+  conflict,
+  error,
+  onClose,
+  onApply,
+  onReload,
+}) => {
+  const { t } = useTranslation();
+  return (
+    <Modal opened={opened} onClose={onClose} size="lg" title={t('kiro.rules.review.title')}>
+      <Stack>
+        <Text size="sm" c="dimmed">
+          {t('kiro.rules.review.summary', { count })}
+        </Text>
+
+        {conflict && (
+          <Alert color="orange" title={t('kiro.rules.review.conflictTitle')}>
+            <Stack gap="xs">
+              <Text size="sm">{t('kiro.rules.review.conflictBody')}</Text>
+              <Group>
+                <Button
+                  size="xs"
+                  variant="light"
+                  color="orange"
+                  leftSection={<IconReload width={14} height={14} />}
+                  onClick={onReload}
+                >
+                  {t('kiro.rules.review.reload')}
+                </Button>
+              </Group>
+            </Stack>
+          </Alert>
+        )}
+        {error && !conflict && (
+          <Alert color="red" title={t('kiro.rules.review.failedTitle')}>
+            {error}
+          </Alert>
+        )}
+
+        {diff.rules.length > 0 && (
+          <Stack gap={6}>
+            <Text fw={600} size="sm">
+              {t('kiro.rules.review.ruleChanges')}
+            </Text>
+            <List spacing="xs" size="sm">
+              {diff.rules.map((d) => (
+                <List.Item key={`${d.kind}-${d.id}`}>
+                  <Group gap={6} wrap="wrap">
+                    {d.kind === 'added' && <Badge color="teal" variant="light">{t('kiro.rules.review.added')}</Badge>}
+                    {d.kind === 'removed' && <Badge color="red" variant="light">{t('kiro.rules.review.removed')}</Badge>}
+                    {d.kind === 'changed' && <Badge color="blue" variant="light">{t('kiro.rules.review.changed')}</Badge>}
+                    {d.kind === 'reordered' && (
+                      <Badge color="grape" variant="light">{t('kiro.rules.review.reordered')}</Badge>
+                    )}
+                    <Text size="sm" fw={500}>
+                      {d.label}
+                    </Text>
+                    <Code>{d.id}</Code>
+                  </Group>
+                  {d.kind === 'changed' && (
+                    <Stack gap={2} pl="md" mt={4}>
+                      {d.fields.map((f) => (
+                        <FieldChange key={String(f.field)} change={f} />
+                      ))}
+                    </Stack>
+                  )}
+                  {d.kind === 'reordered' && (
+                    <Text size="xs" c="dimmed" pl="md">
+                      {t('kiro.rules.review.movedTo', { from: d.from + 1, to: d.to + 1 })}
+                    </Text>
+                  )}
+                </List.Item>
+              ))}
+            </List>
+          </Stack>
+        )}
+
+        {diff.switches.length > 0 && (
+          <Stack gap={6}>
+            <Text fw={600} size="sm">
+              {t('kiro.rules.review.protectionChanges')}
+            </Text>
+            <List spacing="xs" size="sm">
+              {diff.switches.map((s) => (
+                <List.Item key={s.key}>
+                  <Text size="sm" fw={500}>
+                    {t(`kiro.rules.protection.${s.key}.name`)}
+                  </Text>
+                  <Stack gap={2} pl="md" mt={4}>
+                    {s.fields.map((f) => (
+                      <FieldChange key={String(f.field)} change={f} />
+                    ))}
+                  </Stack>
+                </List.Item>
+              ))}
+            </List>
+          </Stack>
+        )}
+
+        {diff.blockMessage && (
+          <Stack gap={6}>
+            <Text fw={600} size="sm">
+              {t('kiro.rules.review.blockMessageChange')}
+            </Text>
+            <Text size="sm">
+              <Code>{fmtVal(diff.blockMessage.from)}</Code> → <Code>{fmtVal(diff.blockMessage.to)}</Code>
+            </Text>
+          </Stack>
+        )}
+
+        <Group justify="flex-end" mt="sm">
+          <Button variant="default" onClick={onClose} disabled={saving}>
+            {t('kiro.rules.review.cancel')}
+          </Button>
+          <Button onClick={onApply} loading={saving} disabled={saving || conflict}>
+            {t('kiro.rules.review.apply')}
+          </Button>
+        </Group>
+      </Stack>
+    </Modal>
+  );
+};
