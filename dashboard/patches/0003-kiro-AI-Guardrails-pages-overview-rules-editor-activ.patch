+/** The AI Guardrails "Overview" page: a bento command center over the stats API. */
+import { AreaChart } from '@mantine/charts';
+import {
+  Anchor,
+  Box,
+  Grid,
+  Group,
+  SegmentedControl,
+  SimpleGrid,
+  Skeleton,
+  Stack,
+  Text,
+} from '@mantine/core';
+import { Link } from '@tanstack/react-router';
+import { useMemo, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+
+import { PortalPageHeader } from '@/kiro/shell/Page';
+
+import { useHistory, useStats } from '../api';
+import { fmtMs, fmtNumber, useRuleLabel, useTimeAgo } from '../format';
+import { EmptyState, ErrorState, SectionCard } from '../ui';
+import { axisLabel, buildSeries, type RangeHours, sparkFrom } from './data';
+import { KpiCard } from './KpiCard';
+import { LiveActivity } from './LiveActivity';
+import { RankedBars } from './RankedBars';
+import { SummaryHero } from './SummaryHero';
+
+export const OverviewPage = () => {
+  const { t, i18n } = useTranslation();
+  const [hours, setHours] = useState<RangeHours>(24);
+  const ruleLabel = useRuleLabel();
+  const timeAgo = useTimeAgo();
+
+  const stats = useStats(hours);
+  const history = useHistory();
+
+  const s = stats.data;
+  const daily = hours === 168;
+  const series = useMemo(() => (s ? buildSeries(s.timeline, hours) : []), [s, hours]);
+
+  const chartData = useMemo(
+    () => series.map((p) => ({ ...p, date: axisLabel(p.date, daily, i18n.language) })),
+    [series, daily, i18n.language]
+  );
+  const windowHasTraffic = series.some((p) => p.allowed + p.blocked + p.rate_limited > 0);
+
+  const rangeControl = (
+    <SegmentedControl
+      size="sm"
+      value={String(hours)}
+      onChange={(v) => setHours(Number(v) as RangeHours)}
+      aria-label={t('kiro.overview.range.aria')}
+      data={[
+        { value: '1', label: t('kiro.overview.range.h1') },
+        { value: '24', label: t('kiro.overview.range.h24') },
+        { value: '168', label: t('kiro.overview.range.d7') },
+      ]}
+    />
+  );
+
+  const num = (n: number | null | undefined) => fmtNumber(n, i18n.language);
+  const blockedPct = s && s.requests > 0 ? Math.round((s.blocked / s.requests) * 100) : 0;
+  const kiro = s?.latency_ms.kiro;
+  const ai = s?.latency_ms.ai;
+
+  return (
+    <Box maw={1440}>
+      <PortalPageHeader
+        title={t('kiro.overview.title')}
+        subtitle={t('kiro.overview.subtitle')}
+        actions={rangeControl}
+      />
+
+      {stats.error ? (
+        <SectionCard title={t('kiro.overview.title')}>
+          <ErrorState error={stats.error} />
+        </SectionCard>
+      ) : (
+        <Stack gap="md">
+          <SummaryHero stats={s} loading={stats.isPending} />
+
+          <SimpleGrid cols={{ base: 1, sm: 2, lg: 5 }} spacing="md">
+            <KpiCard
+              label={t('kiro.overview.kpi.requests')}
+              value={num(s?.requests)}
+              spark={sparkFrom(series, 'allowed')}
+              color="indigo.4"
+              loading={stats.isPending}
+            />
+            <KpiCard
+              label={t('kiro.overview.kpi.blocked')}
+              value={num(s?.blocked)}
+              note={t('kiro.overview.kpi.blockedPct', { pct: blockedPct })}
+              spark={sparkFrom(series, 'blocked')}
+              color="red.5"
+              loading={stats.isPending}
+            />
+            <KpiCard
+              label={t('kiro.overview.kpi.users')}
+              value={num(s?.users)}
+              color="teal.5"
+              loading={stats.isPending}
+            />
+            <KpiCard
+              label={t('kiro.overview.kpi.latency')}
+              value={kiro ? fmtMs(kiro.p50) : '–'}
+              note={`${t('kiro.overview.latency.p95')} ${kiro ? fmtMs(kiro.p95) : '–'} · ${t('kiro.overview.kpi.latencyNote')}`}
+              color="cyan.5"
+              loading={stats.isPending}
+            />
+            <KpiCard
+              label={t('kiro.overview.kpi.protections')}
+              value={s ? `${num(s.protections_on)}/${num(s.protections_total)}` : '–'}
+              note={s ? t('kiro.overview.kpi.rulesEnabled', { count: s.rules_enabled }) : undefined}
+              color="violet.5"
+              loading={stats.isPending}
+            />
+          </SimpleGrid>
+
+          <Grid gutter="md">
+            <Grid.Col span={{ base: 12, lg: 8 }}>
+              <SectionCard
+                title={t('kiro.overview.chart.title')}
+                hint={t(daily ? 'kiro.overview.chart.hintDaily' : 'kiro.overview.chart.hintHourly')}
+              >
+                {stats.isPending ? (
+                  <Skeleton height={240} radius="sm" />
+                ) : !windowHasTraffic ? (
+                  <EmptyState title={t('kiro.overview.chart.empty')} body={t('kiro.overview.chart.emptyBody')} />
+                ) : (
+                  <AreaChart
+                    h={240}
+                    data={chartData}
+                    dataKey="date"
+                    type="stacked"
+                    withLegend
+                    curveType="monotone"
+                    valueFormatter={(v) => num(v)}
+                    series={[
+                      { name: 'allowed', label: t('kiro.guard.result.allowed'), color: 'teal.5' },
+                      { name: 'blocked', label: t('kiro.guard.result.blocked'), color: 'red.5' },
+                      { name: 'rate_limited', label: t('kiro.guard.result.rate_limited'), color: 'yellow.5' },
+                    ]}
+                  />
+                )}
+              </SectionCard>
+            </Grid.Col>
+
+            <Grid.Col span={{ base: 12, lg: 4 }}>
+              <SectionCard
+                title={t('kiro.overview.byRule.title')}
+                action={
+                  <Anchor component={Link} to="/guardrails/rules" size="sm">
+                    {t('kiro.overview.byRule.allRules')}
+                  </Anchor>
+                }
+                h="100%"
+              >
+                {stats.isPending ? (
+                  <Skeleton height={160} radius="sm" />
+                ) : !s || s.by_rule.length === 0 ? (
+                  <EmptyState title={t('kiro.overview.byRule.empty')} />
+                ) : (
+                  <RankedBars
+                    color="red"
+                    rows={s.by_rule.slice(0, 6).map(([id, n]) => ({
+                      key: id,
+                      label: ruleLabel(id) || id,
+                      value: n,
+                    }))}
+                    valueFmt={num}
+                  />
+                )}
+              </SectionCard>
+            </Grid.Col>
+
+            <Grid.Col span={{ base: 12, lg: 7 }}>
+              <LiveActivity hours={hours} />
+            </Grid.Col>
+
+            <Grid.Col span={{ base: 12, lg: 5 }}>
+              <SectionCard title={t('kiro.overview.byUser.title')} hint={t('kiro.overview.byUser.hint')} h="100%">
+                {stats.isPending ? (
+                  <Skeleton height={160} radius="sm" />
+                ) : !s || s.blocked_by_user.length === 0 ? (
+                  <EmptyState title={t('kiro.overview.byUser.empty')} />
+                ) : (
+                  <RankedBars
+                    color="red"
+                    rows={s.blocked_by_user.slice(0, 6).map(([user, n]) => ({
+                      key: user,
+                      label: (
+                        <Text span ff="monospace" size="sm">
+                          {user}
+                        </Text>
+                      ),
+                      value: n,
+                    }))}
+                    valueFmt={num}
+                  />
+                )}
+              </SectionCard>
+            </Grid.Col>
+
+            <Grid.Col span={{ base: 12, lg: 6 }}>
+              <SectionCard title={t('kiro.overview.latency.title')} hint={t('kiro.overview.latency.hint')} h="100%">
+                {stats.isPending ? (
+                  <Skeleton height={120} radius="sm" />
+                ) : (
+                  <SimpleGrid cols={2} spacing="lg">
+                    {(
+                      [
+                        ['kiro', kiro],
+                        ['ai', ai],
+                      ] as const
+                    ).map(([key, l]) => (
+                      <Stack key={key} gap={4}>
+                        <Text size="sm" fw={600}>
+                          {t(`kiro.guard.path.${key}`)}
+                        </Text>
+                        <Group gap="xl">
+                          <Box>
+                            <Text size="xs" c="dimmed">
+                              {t('kiro.overview.latency.p50')}
+                            </Text>
+                            <Text fw={650} fz="lg" style={{ fontVariantNumeric: 'tabular-nums' }}>
+                              {fmtMs(l?.p50)}
+                            </Text>
+                          </Box>
+                          <Box>
+                            <Text size="xs" c="dimmed">
+                              {t('kiro.overview.latency.p95')}
+                            </Text>
+                            <Text fw={650} fz="lg" style={{ fontVariantNumeric: 'tabular-nums' }}>
+                              {fmtMs(l?.p95)}
+                            </Text>
+                          </Box>
+                        </Group>
+                        <Text size="xs" c="dimmed">
+                          {t('kiro.overview.latency.samples', { count: l?.n ?? 0 })}
+                        </Text>
+                      </Stack>
+                    ))}
+                  </SimpleGrid>
+                )}
+              </SectionCard>
+            </Grid.Col>
+
+            <Grid.Col span={{ base: 12, lg: 6 }}>
+              <SectionCard
+                title={t('kiro.overview.changes.title')}
+                action={
+                  <Anchor component={Link} to="/guardrails/rules" size="sm">
+                    {t('kiro.overview.changes.manage')}
+                  </Anchor>
+                }
+                h="100%"
+              >
+                {history.isPending ? (
+                  <Skeleton height={120} radius="sm" />
+                ) : history.error ? (
+                  <ErrorState error={history.error} />
+                ) : !history.data || history.data.length === 0 ? (
+                  <EmptyState title={t('kiro.overview.changes.empty')} />
+                ) : (
+                  <Stack gap="sm">
+                    {history.data.slice(0, 5).map((c) => (
+                      <Group key={c.commit} gap="sm" wrap="nowrap" align="flex-start">
+                        <Box flex={1}>
+                          <Text size="sm">{c.summary}</Text>
+                          <Text size="xs" c="dimmed">
+                            {c.author} · {timeAgo(c.time)}
+                          </Text>
+                        </Box>
+                      </Group>
+                    ))}
+                  </Stack>
+                )}
+              </SectionCard>
+            </Grid.Col>
+          </Grid>
+        </Stack>
+      )}
+    </Box>
+  );
+};
