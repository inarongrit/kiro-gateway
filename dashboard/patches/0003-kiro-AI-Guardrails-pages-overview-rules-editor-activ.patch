+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+/** A single KPI card: label, big number, optional note and sparkline. */
+import { Sparkline } from '@mantine/charts';
+import { Box, Card, Group, Skeleton, Stack, Text } from '@mantine/core';
+import type { FC, ReactNode } from 'react';
+
+export const KpiCard: FC<{
+  label: string;
+  value: ReactNode;
+  note?: ReactNode;
+  spark?: number[];
+  color?: string;
+  loading?: boolean;
+}> = ({ label, value, note, spark, color = 'indigo.4', loading }) => (
+  <Card withBorder h="100%">
+    <Stack gap={6} h="100%" justify="space-between">
+      <Text size="sm" c="dimmed">
+        {label}
+      </Text>
+      <Group justify="space-between" align="flex-end" wrap="nowrap" gap="sm">
+        <Box>
+          {loading ? (
+            <Skeleton height={32} width={88} radius="sm" />
+          ) : (
+            <Text fw={650} fz={30} lh={1.1} style={{ fontVariantNumeric: 'tabular-nums' }}>
+              {value}
+            </Text>
+          )}
+          {note && (
+            <Text size="xs" c="dimmed" mt={2}>
+              {note}
+            </Text>
+          )}
+        </Box>
+        {spark && spark.some((n) => n > 0) && (
+          <Sparkline
+            w={76}
+            h={34}
+            data={spark}
+            color={color}
+            fillOpacity={0.18}
+            strokeWidth={1.6}
+            curveType="monotone"
+          />
+        )}
+      </Group>
+    </Stack>
+  </Card>
+);
