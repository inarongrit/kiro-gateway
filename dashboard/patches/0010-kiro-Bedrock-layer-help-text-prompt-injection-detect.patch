         "timeoutMs": "Zaman aşımı (ms)",
         "failMode": "Bedrock yavaşsa veya erişilemiyorsa",
diff --git a/src/locales/zh/common.json b/src/locales/zh/common.json
index d5b7c43..79aac11 100644
