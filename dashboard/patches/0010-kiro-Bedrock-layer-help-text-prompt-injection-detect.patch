+++ b/src/locales/es/common.json
@@ -789,7 +789,7 @@
         },
         "kiro_ml_guard": {
           "name": "Bedrock Guardrails (segunda capa)",
-          "help": "Tras las reglas de bloqueo, Amazon Bedrock revisa el prompt en busca de datos personales (nombres, direcciones, teléfonos, datos bancarios, contraseñas), ataques de prompt y exfiltración de datos. Añade unos 0,5 s por chat de Kiro."
+          "help": "Tras las reglas de bloqueo, Amazon Bedrock revisa el prompt en busca de datos personales (nombres, direcciones, teléfonos, datos bancarios, contraseñas, claves) y de solicitudes para sacar datos de la empresa fuera de la organización. La detección de inyección de prompts está desactivada (bloqueaba prompts de programación normales). Añade unos 0,5 s por chat de Kiro."
         },
         "timeoutMs": "Tiempo límite (ms)",
         "failMode": "Si Bedrock va lento o no está disponible",
