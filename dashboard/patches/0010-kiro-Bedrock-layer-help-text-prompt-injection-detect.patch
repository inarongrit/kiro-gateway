 5 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/src/locales/de/common.json b/src/locales/de/common.json
index c6a89a5..0b54009 100644
--- a/src/locales/de/common.json
+++ b/src/locales/de/common.json
@@ -789,7 +789,7 @@
         },
         "kiro_ml_guard": {
           "name": "Bedrock Guardrails (zweite Ebene)",
-          "help": "Nach den Sperrregeln prüft Amazon Bedrock den Prompt auf personenbezogene Daten (Namen, Adressen, Telefonnummern, Bankdaten, Passwörter), Prompt-Angriffe und Datenabfluss. Kostet etwa 0,5 s pro Kiro-Chat."
+          "help": "Nach den Sperrregeln prüft Amazon Bedrock den Prompt auf personenbezogene Daten (Namen, Adressen, Telefonnummern, Bankdaten, Passwörter, Schlüssel) und auf Anfragen, Unternehmensdaten nach außen zu bringen. Die Erkennung von Prompt-Injection ist aus (sie sperrte normale Programmier-Prompts). Kostet etwa 0,5 s pro Kiro-Chat."
         },
         "timeoutMs": "Zeitlimit (ms)",
         "failMode": "Wenn Bedrock langsam oder nicht erreichbar ist",
diff --git a/src/locales/en/common.json b/src/locales/en/common.json
index 5008450..f6aa5dd 100644
--- a/src/locales/en/common.json
+++ b/src/locales/en/common.json
@@ -789,7 +789,7 @@
         },
         "kiro_ml_guard": {
           "name": "Bedrock Guardrails (second layer)",
-          "help": "After the block rules pass, Amazon Bedrock checks the prompt for personal data (names, addresses, phones, bank details, passwords), prompt attacks and data exfiltration. Adds about 0.5 s per Kiro chat."
+          "help": "After the block rules pass, Amazon Bedrock checks the prompt for personal data (names, addresses, phones, bank details, passwords, keys) and requests to move company data outside the organization. Prompt-injection detection is off (it blocked normal coding prompts). Adds about 0.5 s per Kiro chat."
         },
         "timeoutMs": "Timeout (ms)",
         "failMode": "If Bedrock is slow or unavailable",
diff --git a/src/locales/es/common.json b/src/locales/es/common.json
index 9e67632..7929abc 100644
