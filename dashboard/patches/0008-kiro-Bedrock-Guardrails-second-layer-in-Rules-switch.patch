diff --git a/src/kiro/guardrails/format.ts b/src/kiro/guardrails/format.ts
index 1de4474..5f748ee 100644
--- a/src/kiro/guardrails/format.ts
+++ b/src/kiro/guardrails/format.ts
@@ -31,6 +31,16 @@ export const useRuleLabel = () => {
       if (m.has(id)) return m.get(id)!;
       if (id === 'prompt-guard') return t('kiro.guard.rule.promptGuard');
       if (id === 'unknown') return t('kiro.guard.rule.unknown');
+      if (id === 'uninspectable') return t('kiro.guard.rule.uninspectable');
+      if (id === 'ml-unavailable') return t('kiro.guard.rule.mlUnavailable');
+      if (id.startsWith('bedrock:')) {
+        // bedrock:pii:NAME -> "Bedrock · Name"; bedrock:topic:Data exfiltration -> "Bedrock · Data exfiltration"
+        const what = id.split(':').slice(2).join(':') || id.split(':')[1] || '';
+        const pretty = /^[A-Z_]+$/.test(what)
+          ? what.toLowerCase().replace(/_/g, ' ').replace(/^\w/, (c) => c.toUpperCase())
+          : what;
+        return t('kiro.guard.rule.bedrock', { what: pretty });
+      }
       // Only call it removed once the current rules are known (not while they load).
       return data ? t('kiro.guard.rule.removed', { id }) : id;
     };
