diff --git a/src/kiro/guardrails/api.ts b/src/kiro/guardrails/api.ts
index d81f1dd..16ce78f 100644
--- a/src/kiro/guardrails/api.ts
+++ b/src/kiro/guardrails/api.ts
@@ -40,6 +40,8 @@ export type GuardrailSwitches = {
   kiro_rate_limit: { enabled: boolean; requests: number; window_seconds: number };
   ai_prompt_guard: { enabled: boolean };
   ai_token_budget: { enabled: boolean; tokens: number; window_seconds: number };
+  /** Second layer: Amazon Bedrock Guardrails via the ml-guard service (Kiro path only). */
+  kiro_ml_guard: { enabled: boolean; timeout_ms: number; fail_mode: 'open' | 'closed' };
 };
 
 export type GuardrailConfig = {
@@ -100,7 +102,26 @@ export type TestResult = {
   /** True when the Kiro guard's normalisation (full-width / Thai digits, zero-width chars) changed the text. */
   normalised: boolean;
   /** The server never returns the raw match: a masked preview plus UTF-16 offsets into the sent text. */
-  matches: { id: string; label: string; matched: boolean; preview?: string; start?: number; length?: number }[];
+  matches: {
+    id: string;
+    label: string;
+    matched: boolean;
+    preview?: string;
+    start?: number;
+    length?: number;
+    /** "ml" = found by the Bedrock layer; absent = a regex rule. */
+    layer?: 'ml';
+  }[];
+  /** What the second (Bedrock) layer decided, as the gateway would run it. */
+  ml?: {
+    enabled: boolean;
+    available?: boolean;
+    action?: 'allow' | 'block';
+    policies?: string[];
+    latency_ms?: number;
+    fail_mode?: 'open' | 'closed';
+    error?: string;
+  };
 };
 
