+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+/** Formatting and lookup helpers shared by the AI Guardrails pages. */
+import { useMemo } from 'react';
+import { useTranslation } from 'react-i18next';
+
+import { useGuardrails } from './api';
+
+/** Map rule id -> human label; ids not in the current rules file fall back to a readable name. */
+export const useRuleLabel = () => {
+  const { t } = useTranslation();
+  const { data } = useGuardrails();
+  return useMemo(() => {
+    const m = new Map((data?.config.rules ?? []).map((r) => [r.id, r.label]));
+    return (id: string) => {
+      if (!id) return '';
+      if (m.has(id)) return m.get(id)!;
+      if (id === 'prompt-guard') return t('kiro.guard.rule.promptGuard');
+      if (id === 'unknown') return t('kiro.guard.rule.unknown');
+      return id;
+    };
+  }, [data, t]);
+};
+
+export const fmtNumber = (n: number | null | undefined, lang?: string) =>
+  n == null ? '–' : new Intl.NumberFormat(lang).format(n);
+
+export const fmtMs = (n: number | null | undefined) =>
+  n == null ? '–' : n >= 1000 ? `${(n / 1000).toFixed(2)} s` : `${Math.round(n)} ms`;
+
+/** "3 min ago" in the active language. */
+export const useTimeAgo = () => {
+  const { i18n } = useTranslation();
+  return useMemo(() => {
+    const rtf = new Intl.RelativeTimeFormat(i18n.language, { numeric: 'auto' });
+    return (iso: string) => {
+      const s = Math.round((new Date(iso).getTime() - Date.now()) / 1000);
+      const a = Math.abs(s);
+      if (a < 60) return rtf.format(s, 'second');
+      if (a < 3600) return rtf.format(Math.round(s / 60), 'minute');
+      if (a < 86400) return rtf.format(Math.round(s / 3600), 'hour');
+      return rtf.format(Math.round(s / 86400), 'day');
+    };
+  }, [i18n.language]);
+};
+
+export const fmtTime = (iso: string, lang?: string) =>
+  new Intl.DateTimeFormat(lang, { dateStyle: 'medium', timeStyle: 'medium' }).format(new Date(iso));
