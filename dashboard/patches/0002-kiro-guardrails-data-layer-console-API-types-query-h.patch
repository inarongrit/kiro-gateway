index 0000000..315fe15
--- /dev/null
+++ b/src/kiro/guardrails/api.ts
@@ -0,0 +1,188 @@
+/**
+ * Licensed to the Apache Software Foundation (ASF) under one or more
+ * contributor license agreements.  See the NOTICE file distributed with
+ * this work for additional information regarding copyright ownership.
+ * The ASF licenses this file to You under the Apache License, Version 2.0
+ * (the "License"); you may not use this file except in compliance with
+ * the License.  You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+/**
+ * Typed access to the Guardrail Console API for the AI Guardrails pages.
+ * Shapes mirror console/app/rules.py and console/app/main.py.
+ */
+import { keepPreviousData, useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
+
+import { consoleApi } from '@/kiro/api';
+
+export type GuardPath = 'kiro' | 'ai';
+export type EventResult = 'allowed' | 'blocked' | 'rate_limited' | 'error';
+
+export type Rule = {
+  id: string;
+  label: string;
+  description: string;
+  pattern: string;
+  case_insensitive: boolean;
+  applies_to: GuardPath[];
+  enabled: boolean;
+};
+
+export type GuardrailSwitches = {
+  kiro_prompt_guard: { enabled: boolean };
+  kiro_rate_limit: { enabled: boolean; requests: number; window_seconds: number };
+  ai_prompt_guard: { enabled: boolean };
+  ai_token_budget: { enabled: boolean; tokens: number; window_seconds: number };
+};
+
+export type GuardrailConfig = {
+  block_message: string;
+  rules: Rule[];
+  guardrails: GuardrailSwitches;
+};
+
+export type GuardrailsResponse = { config: GuardrailConfig & Record<string, unknown>; version: string };
+export type SaveResponse = GuardrailsResponse & { commit: string };
+
+export type Stats = {
+  hours: number;
+  requests: number;
+  blocked: number;
+  rate_limited: number;
+  users: number;
+  by_rule: [string, number][];
+  blocked_by_user: [string, number][];
+  timeline: { bucket: string; allowed?: number; blocked?: number; rate_limited?: number }[];
+  latency_ms: Record<GuardPath, { p50: number | null; p95: number | null; n: number }>;
+  tokens: number;
+  protections_on: number;
+  protections_total: number;
+  rules_enabled: number;
+};
+
+export type AuditEvent = {
+  ts: string;
+  path: GuardPath;
+  host: string;
+  op: string;
+  status: number;
+  result: EventResult;
+  rule: string;
+  user: string;
+  prompt: string;
+  latency_ms: number;
+  model: string;
+  tokens: number;
+  is_chat: boolean;
+};
+
+export type EventFilter = {
+  q?: string;
+  result?: '' | EventResult;
+  path?: '' | GuardPath;
+  hours?: number;
+  all_ops?: boolean;
+  limit?: number;
+};
+
+export type TestResult = {
+  path: GuardPath;
+  guard_enabled: boolean;
+  would_block: boolean;
+  rules_checked: number;
+  matches: { id: string; label: string; matched: boolean; match?: string }[];
+};
+
+export type PatternCheck = { valid: boolean; error: string | null };
+export type Change = { commit: string; author: string; time: string; summary: string };
+
+const qs = (o: Record<string, unknown>) => {
+  const p = new URLSearchParams();
+  Object.entries(o).forEach(([k, v]) => {
+    if (v !== undefined && v !== '' && v !== false) p.set(k, String(v));
+  });
+  const s = p.toString();
+  return s ? `?${s}` : '';
+};
+
+export const guardKeys = {
+  config: ['kiro', 'guardrails'] as const,
+  stats: (hours: number) => ['kiro', 'stats', hours] as const,
+  events: (f: EventFilter) => ['kiro', 'events', f] as const,
+  history: ['kiro', 'history'] as const,
+};
+
+/** Live data refreshes on the same 5 s cadence as the classic console. */
+export const LIVE_MS = 5000;
+
+export const useGuardrails = () =>
+  useQuery({
+    queryKey: guardKeys.config,
+    queryFn: () => consoleApi<GuardrailsResponse>('GET', '/api/guardrails'),
+  });
+
+export const useStats = (hours = 24) =>
+  useQuery({
+    queryKey: guardKeys.stats(hours),
+    queryFn: () => consoleApi<Stats>('GET', `/api/stats${qs({ hours })}`),
+    refetchInterval: LIVE_MS,
+    placeholderData: keepPreviousData,
+  });
+
+export const useEvents = (f: EventFilter, live = true) =>
+  useQuery({
+    queryKey: guardKeys.events(f),
+    queryFn: () => consoleApi<{ events: AuditEvent[] }>('GET', `/api/events${qs(f)}`).then((r) => r.events),
+    refetchInterval: live ? LIVE_MS : false,
+    placeholderData: keepPreviousData,
+  });
+
+export const useHistory = () =>
+  useQuery({
+    queryKey: guardKeys.history,
+    queryFn: () => consoleApi<{ changes: Change[] }>('GET', '/api/history').then((r) => r.changes),
+  });
+
+export const checkPattern = (pattern: string) =>
+  consoleApi<PatternCheck>('POST', '/api/check-pattern', { pattern });
+
+export const testPrompt = (text: string, path: GuardPath) =>
+  consoleApi<TestResult>('POST', '/api/test-prompt', { text, path });
+
+/**
+ * Save the whole config. The console applies it to the gateway, commits it to git and
+ * returns 409 when someone else saved first (base_version no longer current).
+ */
+export const useSaveGuardrails = () => {
+  const qc = useQueryClient();
+  return useMutation({
+    mutationFn: ({ config, base_version }: { config: GuardrailConfig; base_version: string }) =>
+      consoleApi<SaveResponse>('PUT', '/api/guardrails', {
+        block_message: config.block_message,
+        rules: config.rules,
+        guardrails: config.guardrails,
+        base_version,
+      }),
+    onSuccess: (data) => {
+      qc.setQueryData(guardKeys.config, { config: data.config, version: data.version });
+      qc.invalidateQueries({ queryKey: guardKeys.history });
+      qc.invalidateQueries({ queryKey: ['kiro', 'stats'] });
+    },
+  });
+};
+
+/** Rule id from a human label: "AWS access key ID" -> "aws-access-key-id". */
+export const slugify = (label: string) =>
+  label
+    .toLowerCase()
+    .normalize('NFKD')
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '')
+    .slice(0, 63);
