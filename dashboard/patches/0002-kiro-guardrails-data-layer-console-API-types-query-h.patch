+/** Small building blocks shared by the AI Guardrails pages. */
+import { Badge, Card, Center, Group, Loader, Stack, Text, ThemeIcon } from '@mantine/core';
+import type { FC, ReactNode } from 'react';
+import { useTranslation } from 'react-i18next';
+
+import IconAlert from '~icons/tabler/alert-triangle';
+import IconInbox from '~icons/tabler/inbox';
+
+import type { EventResult, GuardPath } from './api';
+
+const RESULT_COLOR: Record<EventResult, string> = {
+  allowed: 'teal',
+  blocked: 'red',
+  rate_limited: 'yellow',
+  error: 'gray',
+};
+
+export const ResultBadge: FC<{ result: EventResult }> = ({ result }) => {
+  const { t } = useTranslation();
+  return (
+    <Badge color={RESULT_COLOR[result] ?? 'gray'} variant="light" radius="sm">
+      {t(`kiro.guard.result.${result}`)}
+    </Badge>
+  );
+};
+
+export const PathBadge: FC<{ path: GuardPath }> = ({ path }) => {
+  const { t } = useTranslation();
+  return (
+    <Badge color={path === 'kiro' ? 'violet' : 'blue'} variant="outline" radius="sm">
+      {t(`kiro.guard.path.${path}`)}
+    </Badge>
+  );
+};
+
+/** Card with a title row (title, optional hint and right-side action). */
+export const SectionCard: FC<{
+  title: ReactNode;
+  hint?: ReactNode;
+  action?: ReactNode;
+  children: ReactNode;
+  h?: number | string;
+}> = ({ title, hint, action, children, h }) => (
+  <Card h={h} withBorder>
+    <Group justify="space-between" align="flex-start" mb="md" wrap="nowrap">
+      <Stack gap={2}>
+        <Text fw={600}>{title}</Text>
+        {hint && (
+          <Text size="xs" c="dimmed">
+            {hint}
+          </Text>
+        )}
+      </Stack>
+      {action}
+    </Group>
+    {children}
+  </Card>
+);
+
+export const LoadingState: FC = () => (
+  <Center py="xl">
+    <Loader size="sm" />
+  </Center>
+);
+
+export const EmptyState: FC<{ title: string; body?: string }> = ({ title, body }) => (
+  <Stack align="center" gap={6} py="xl">
+    <ThemeIcon variant="light" color="gray" size={40} radius="md">
+      <IconInbox width={20} height={20} />
+    </ThemeIcon>
+    <Text fw={500}>{title}</Text>
+    {body && (
+      <Text size="sm" c="dimmed" ta="center" maw={420}>
+        {body}
+      </Text>
+    )}
+  </Stack>
+);
+
+export const ErrorState: FC<{ error: unknown }> = ({ error }) => {
+  const { t } = useTranslation();
+  return (
+    <Group gap="sm" py="md" c="red">
+      <IconAlert width={18} height={18} />
+      <Text size="sm">
+        {t('kiro.guard.loadError')}: {error instanceof Error ? error.message : String(error)}
+      </Text>
+    </Group>
+  );
+};
