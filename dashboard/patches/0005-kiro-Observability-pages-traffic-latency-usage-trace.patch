+/** The "Traces" page: a filterable list of recent requests, each opening a waterfall detail. */
+import { Badge, Box, Group, SegmentedControl, Skeleton, Stack, Table, Text, Tooltip } from '@mantine/core';
+import { useMemo, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+
+import { grafana, type TraceKind, useTraces } from '@/kiro/observability/api';
+import { PortalPageHeader } from '@/kiro/shell/Page';
+
+import { fmtMs, fmtTime } from '../../guardrails/format';
+import { EmptyState, ErrorState, SectionCard } from '../../guardrails/ui';
+import { RangeHeader } from '../usage/RangeHeader';
+import { statusColor, type TraceHours, useHostLabel } from './data';
+import { TraceDrawer } from './TraceDrawer';
+
+/** "12s ago" style relative label for an epoch-ms timestamp. */
+const useRelative = () => {
+  const { i18n } = useTranslation();
+  return (ms: number) => {
+    const rtf = new Intl.RelativeTimeFormat(i18n.language, { numeric: 'auto' });
+    const s = Math.round((ms - Date.now()) / 1000);
+    const a = Math.abs(s);
+    if (a < 60) return rtf.format(s, 'second');
+    if (a < 3600) return rtf.format(Math.round(s / 60), 'minute');
+    if (a < 86400) return rtf.format(Math.round(s / 3600), 'hour');
+    return rtf.format(Math.round(s / 86400), 'day');
+  };
+};
+
+export const TracesPage = () => {
+  const { t, i18n } = useTranslation();
+  const [hours, setHours] = useState<TraceHours>(1);
+  const [kind, setKind] = useState<TraceKind>('chat');
+  const [selected, setSelected] = useState<string | null>(null);
+  const relative = useRelative();
+  const hostLabel = useHostLabel();
+
+  const traces = useTraces(hours, kind);
+  const rows = useMemo(() => traces.data?.traces ?? [], [traces.data]);
+  const slowest = useMemo(() => Math.max(1, ...rows.map((r) => r.duration_ms)), [rows]);
+
+  const header = (
+    <RangeHeader
+      value={String(hours)}
+      onChange={(v) => setHours(Number(v) as TraceHours)}
+      options={[
+        { value: '0.25', label: t('kiro.traces.range.m15') },
+        { value: '1', label: t('kiro.traces.range.h1') },
+        { value: '6', label: t('kiro.traces.range.h6') },
+        { value: '24', label: t('kiro.traces.range.h24') },
+      ]}
+      rangeAria={t('kiro.traces.range.aria')}
+      grafanaUrl={grafana.traces}
+      grafanaHours={hours}
+      grafanaLabel={t('kiro.traces.grafana')}
+    />
+  );
+
+  return (
+    <Box maw={1440}>
+      <PortalPageHeader title={t('kiro.traces.title')} subtitle={t('kiro.traces.subtitle')} actions={header} />
+
+      <SectionCard
+        title={t('kiro.traces.list.title')}
+        hint={t('kiro.traces.list.hint')}
+        action={
+          <SegmentedControl
+            size="sm"
+            value={kind}
+            onChange={(v) => setKind(v as TraceKind)}
+            aria-label={t('kiro.traces.filter.aria')}
+            data={[
+              { value: 'chat', label: t('kiro.traces.filter.chat') },
+              { value: 'all', label: t('kiro.traces.filter.all') },
+              { value: 'slow', label: t('kiro.traces.filter.slow') },
+              { value: 'errors', label: t('kiro.traces.filter.errors') },
+            ]}
+          />
+        }
+      >
+        {traces.isPending ? (
+          <Skeleton height={320} radius="sm" />
+        ) : traces.error ? (
+          <ErrorState error={traces.error} />
+        ) : rows.length === 0 ? (
+          <EmptyState title={t('kiro.traces.list.empty')} body={t('kiro.traces.list.emptyBody')} />
+        ) : (
+          <Table.ScrollContainer minWidth={720}>
+            <Table highlightOnHover verticalSpacing="xs">
+              <Table.Thead>
+                <Table.Tr>
+                  <Table.Th w={110}>{t('kiro.traces.col.time')}</Table.Th>
+                  <Table.Th>{t('kiro.traces.col.request')}</Table.Th>
+                  <Table.Th>{t('kiro.traces.col.host')}</Table.Th>
+                  <Table.Th w={80}>{t('kiro.traces.col.status')}</Table.Th>
+                  <Table.Th w={200}>{t('kiro.traces.col.duration')}</Table.Th>
+                </Table.Tr>
+              </Table.Thead>
+              <Table.Tbody>
+                {rows.map((r) => {
+                  const host = hostLabel(r.host);
+                  const barPct = Math.max((r.duration_ms / slowest) * 100, 1);
+                  return (
+                    <Table.Tr
+                      key={r.trace_id}
+                      style={{ cursor: 'pointer' }}
+                      onClick={() => setSelected(r.trace_id)}
+                    >
+                      <Table.Td>
+                        <Tooltip label={fmtTime(new Date(r.start_ms).toISOString(), i18n.language)} withArrow openDelay={300}>
+                          <Text size="sm" c="dimmed">
+                            {relative(r.start_ms)}
+                          </Text>
+                        </Tooltip>
+                      </Table.Td>
+                      <Table.Td>
+                        <Text span ff="monospace" size="sm">
+                          {r.name.startsWith(r.method) ? r.name : `${r.method} ${r.name}`.trim()}
+                        </Text>
+                      </Table.Td>
+                      <Table.Td>
+                        {host ? (
+                          <Stack gap={0}>
+                            <Text size="sm">{host.label}</Text>
+                            <Text size="xs" c="dimmed" ff="monospace">
+                              {host.raw}
+                            </Text>
+                          </Stack>
+                        ) : (
+                          <Text size="sm" c="dimmed" ff="monospace">
+                            {r.host}
+                          </Text>
+                        )}
+                      </Table.Td>
+                      <Table.Td>
+                        <Badge color={statusColor(r.status)} variant="light" radius="sm">
+                          {r.status ?? '–'}
+                        </Badge>
+                      </Table.Td>
+                      <Table.Td>
+                        <Group gap="xs" wrap="nowrap">
+                          <Text size="sm" ff="monospace" style={{ width: 72, textAlign: 'right' }}>
+                            {fmtMs(r.duration_ms)}
+                          </Text>
+                          <Box style={{ flex: 1, height: 4, borderRadius: 2 }} bg="var(--mantine-color-default-border)">
+                            <Box
+                              style={{ width: `${barPct}%`, height: 4, borderRadius: 2 }}
+                              bg={r.duration_ms > 1000 ? 'orange.5' : 'blue.5'}
+                            />
+                          </Box>
+                        </Group>
+                      </Table.Td>
+                    </Table.Tr>
+                  );
+                })}
+              </Table.Tbody>
+            </Table>
+          </Table.ScrollContainer>
+        )}
+      </SectionCard>
+
+      <TraceDrawer traceId={selected} onClose={() => setSelected(null)} />
+    </Box>
+  );
+};
