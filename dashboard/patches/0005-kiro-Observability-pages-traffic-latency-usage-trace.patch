+/** The "Usage" page: who uses Kiro and the AI route, and how many AI tokens they burn. */
+import { AreaChart, BarChart } from '@mantine/charts';
+import { Badge, Box, Grid, Progress, Skeleton, Stack, Table, Text, TextInput } from '@mantine/core';
+import { useMemo, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+
+import { grafana, useUsage } from '@/kiro/observability/api';
+import { PortalPageHeader } from '@/kiro/shell/Page';
+
+import { fmtNumber } from '../../guardrails/format';
+import { EmptyState, ErrorState, SectionCard } from '../../guardrails/ui';
+import { type RangeHours, sumKey, withAxisLabel } from './data';
+import { RangeHeader } from './RangeHeader';
+
+const KpiTile = ({
+  label,
+  value,
+  note,
+  loading,
+}: {
+  label: string;
+  value: string;
+  note?: string;
+  loading: boolean;
+}) => (
+  <Stack gap={6} h="100%" justify="space-between">
+    <Text size="sm" c="dimmed">
+      {label}
+    </Text>
+    <Box>
+      {loading ? (
+        <Skeleton height={32} width={88} radius="sm" />
+      ) : (
+        <Text fw={650} fz={30} lh={1.1} style={{ fontVariantNumeric: 'tabular-nums' }}>
+          {value}
+        </Text>
+      )}
+      {note && (
+        <Text size="xs" c="dimmed" mt={2}>
+          {note}
+        </Text>
+      )}
+    </Box>
+  </Stack>
+);
+
+export const UsagePage = () => {
+  const { t, i18n } = useTranslation();
+  const [hours, setHours] = useState<RangeHours>(24);
+  const [query, setQuery] = useState('');
+
+  const usage = useUsage(hours);
+  const u = usage.data;
+  const loading = usage.isPending;
+  const num = (n: number | null | undefined) => fmtNumber(n, i18n.language);
+
+  const chatRows = useMemo(
+    () => (u ? withAxisLabel(u.chats_by_path.rows, hours, i18n.language) : []),
+    [u, hours, i18n.language]
+  );
+  const chatsHasData = u ? sumKey(u.chats_by_path.rows, 'Kiro') + sumKey(u.chats_by_path.rows, 'AI route') > 0 : false;
+
+  const tokenRows = useMemo(
+    () => (u ? withAxisLabel(u.tokens_over_time, hours, i18n.language) : []),
+    [u, hours, i18n.language]
+  );
+  const hasTokens = (u?.ai_tokens ?? 0) > 0;
+
+  const maxUserTotal = useMemo(() => Math.max(1, ...(u?.users ?? []).map((r) => r.total)), [u]);
+  const filteredUsers = useMemo(() => {
+    const q = query.trim().toLowerCase();
+    const rows = u?.users ?? [];
+    return q ? rows.filter((r) => r.user.toLowerCase().includes(q)) : rows;
+  }, [u, query]);
+
+  const header = (
+    <RangeHeader
+      value={String(hours)}
+      onChange={(v) => setHours(Number(v) as RangeHours)}
+      options={[
+        { value: '1', label: t('kiro.usage.range.h1') },
+        { value: '6', label: t('kiro.usage.range.h6') },
+        { value: '24', label: t('kiro.usage.range.h24') },
+        { value: '168', label: t('kiro.usage.range.d7') },
+      ]}
+      rangeAria={t('kiro.usage.range.aria')}
+      grafanaUrl={grafana.usage}
+      grafanaHours={hours}
+      grafanaLabel={t('kiro.usage.grafana')}
+    />
+  );
+
+  return (
+    <Box maw={1440}>
+      <PortalPageHeader title={t('kiro.usage.title')} subtitle={t('kiro.usage.subtitle')} actions={header} />
+
+      {usage.error ? (
+        <SectionCard title={t('kiro.usage.title')}>
+          <ErrorState error={usage.error} />
+        </SectionCard>
+      ) : (
+        <Stack gap="md">
+          <Grid gutter="md">
+            {(
+              [
+                ['chats', num(u?.kiro_chats), undefined],
+                ['aiCalls', num(u?.ai_calls), undefined],
+                ['users', num(u?.active_users), undefined],
+                ['tokens', num(u?.ai_tokens), t('kiro.usage.kpi.tokensNote')],
+              ] as const
+            ).map(([key, value, note]) => (
+              <Grid.Col key={key} span={{ base: 12, sm: 6, lg: 3 }}>
+                <SectionCard title={t(`kiro.usage.kpi.${key}`)}>
+                  <KpiTile label="" value={value} note={note} loading={loading} />
+                </SectionCard>
+              </Grid.Col>
+            ))}
+          </Grid>
+
+          <SectionCard title={t('kiro.usage.chats.title')} hint={t('kiro.usage.chats.hint')}>
+            {loading ? (
+              <Skeleton height={260} radius="sm" />
+            ) : !chatsHasData ? (
+              <EmptyState title={t('kiro.usage.chats.empty')} body={t('kiro.usage.chats.emptyBody')} />
+            ) : (
+              <BarChart
+                h={260}
+                data={chatRows}
+                dataKey="label"
+                type="stacked"
+                withLegend
+                valueFormatter={(v) => num(v)}
+                series={[
+                  { name: 'Kiro', label: t('kiro.usage.series.kiro'), color: 'violet.5' },
+                  { name: 'AI route', label: t('kiro.usage.series.aiRoute'), color: 'blue.5' },
+                ]}
+              />
+            )}
+          </SectionCard>
+
+          <SectionCard title={t('kiro.usage.users.title')} hint={t('kiro.usage.users.hint')}>
+            {loading ? (
+              <Skeleton height={220} radius="sm" />
+            ) : !u || u.users.length === 0 ? (
+              <EmptyState title={t('kiro.usage.users.empty')} />
+            ) : (
+              <Stack gap="sm">
+                <TextInput
+                  size="sm"
+                  value={query}
+                  onChange={(e) => setQuery(e.currentTarget.value)}
+                  placeholder={t('kiro.usage.users.searchPlaceholder')}
+                  aria-label={t('kiro.usage.users.searchAria')}
+                  maw={320}
+                />
+                <Table.ScrollContainer minWidth={640}>
+                  <Table highlightOnHover verticalSpacing="xs">
+                    <Table.Thead>
+                      <Table.Tr>
+                        <Table.Th>{t('kiro.usage.users.col.user')}</Table.Th>
+                        <Table.Th ta="right">{t('kiro.usage.users.col.kiro')}</Table.Th>
+                        <Table.Th ta="right">{t('kiro.usage.users.col.ai')}</Table.Th>
+                        <Table.Th ta="right">{t('kiro.usage.users.col.blocked')}</Table.Th>
+                        <Table.Th ta="right">{t('kiro.usage.users.col.total')}</Table.Th>
+                        <Table.Th w={160}>{t('kiro.usage.users.col.share')}</Table.Th>
+                      </Table.Tr>
+                    </Table.Thead>
+                    <Table.Tbody>
+                      {filteredUsers.length === 0 ? (
+                        <Table.Tr>
+                          <Table.Td colSpan={6}>
+                            <Text size="sm" c="dimmed" ta="center" py="sm">
+                              {t('kiro.usage.users.noMatch')}
+                            </Text>
+                          </Table.Td>
+                        </Table.Tr>
+                      ) : (
+                        filteredUsers.map((r) => (
+                          <Table.Tr key={r.user}>
+                            <Table.Td>
+                              <Text span ff="monospace" size="sm">
+                                {r.user}
+                              </Text>
+                            </Table.Td>
+                            <Table.Td ta="right">{num(r.kiro)}</Table.Td>
+                            <Table.Td ta="right">{num(r.ai)}</Table.Td>
+                            <Table.Td ta="right">
+                              {r.blocked > 0 ? (
+                                <Badge color="red" variant="light" radius="sm">
+                                  {num(r.blocked)}
+                                </Badge>
+                              ) : (
+                                num(r.blocked)
+                              )}
+                            </Table.Td>
+                            <Table.Td ta="right" fw={600}>
+                              {num(r.total)}
+                            </Table.Td>
+                            <Table.Td>
+                              <Progress
+                                value={(r.total / maxUserTotal) * 100}
+                                color="violet"
+                                size="sm"
+                                radius="xl"
+                                aria-label={t('kiro.usage.users.shareAria', { user: r.user })}
+                              />
+                            </Table.Td>
+                          </Table.Tr>
+                        ))
+                      )}
+                    </Table.Tbody>
+                  </Table>
+                </Table.ScrollContainer>
+              </Stack>
+            )}
+          </SectionCard>
+
+          <Grid gutter="md">
+            <Grid.Col span={{ base: 12, lg: 6 }}>
+              <SectionCard title={t('kiro.usage.tokens.title')} hint={t('kiro.usage.tokens.hint')} h="100%">
+                {loading ? (
+                  <Skeleton height={200} radius="sm" />
+                ) : !hasTokens || !u || u.tokens_by_consumer.length === 0 ? (
+                  <EmptyState title={t('kiro.usage.tokens.empty')} body={t('kiro.usage.tokens.emptyBody')} />
+                ) : (
+                  <Table verticalSpacing="xs">
+                    <Table.Thead>
+                      <Table.Tr>
+                        <Table.Th>{t('kiro.usage.tokens.col.consumer')}</Table.Th>
+                        <Table.Th>{t('kiro.usage.tokens.col.model')}</Table.Th>
+                        <Table.Th ta="right">{t('kiro.usage.tokens.col.prompt')}</Table.Th>
+                        <Table.Th ta="right">{t('kiro.usage.tokens.col.completion')}</Table.Th>
+                        <Table.Th ta="right">{t('kiro.usage.tokens.col.total')}</Table.Th>
+                      </Table.Tr>
+                    </Table.Thead>
+                    <Table.Tbody>
+                      {u.tokens_by_consumer.map((r) => (
+                        <Table.Tr key={`${r.consumer}:${r.model}`}>
+                          <Table.Td>
+                            <Text span ff="monospace" size="sm">
+                              {r.consumer}
+                            </Text>
+                          </Table.Td>
+                          <Table.Td>{r.model}</Table.Td>
+                          <Table.Td ta="right">{num(r.prompt)}</Table.Td>
+                          <Table.Td ta="right">{num(r.completion)}</Table.Td>
+                          <Table.Td ta="right" fw={600}>
+                            {num(r.prompt + r.completion)}
+                          </Table.Td>
+                        </Table.Tr>
+                      ))}
+                    </Table.Tbody>
+                  </Table>
+                )}
+              </SectionCard>
+            </Grid.Col>
+
+            <Grid.Col span={{ base: 12, lg: 6 }}>
+              <SectionCard title={t('kiro.usage.tokensChart.title')} hint={t('kiro.usage.tokensChart.hint')} h="100%">
+                {loading ? (
+                  <Skeleton height={200} radius="sm" />
+                ) : !hasTokens ? (
+                  <EmptyState title={t('kiro.usage.tokensChart.empty')} body={t('kiro.usage.tokensChart.emptyBody')} />
+                ) : (
+                  <AreaChart
+                    h={200}
+                    data={tokenRows}
+                    dataKey="label"
+                    curveType="monotone"
+                    withDots={false}
+                    valueFormatter={(v) => num(v)}
+                    series={[{ name: 'tokens', label: t('kiro.usage.series.tokens'), color: 'teal.5' }]}
+                  />
+                )}
+              </SectionCard>
+            </Grid.Col>
+          </Grid>
+        </Stack>
+      )}
+    </Box>
+  );
+};
