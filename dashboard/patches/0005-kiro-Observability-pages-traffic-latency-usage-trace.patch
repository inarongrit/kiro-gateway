+/** Header actions shared by observability pages: a time-range picker + Grafana escape hatch. */
+import { Button, Group, SegmentedControl } from '@mantine/core';
+import type { FC } from 'react';
+
+import { grafana } from '@/kiro/observability/api';
+import IconExternal from '~icons/tabler/external-link';
+
+export type RangeOption = { value: string; label: string };
+
+/**
+ * Time-range SegmentedControl plus a subtle "Open in Grafana" button. Generic over the
+ * caller's range values so both Usage (1h/6h/24h/7d) and Traces (15m/1h/6h/24h) reuse it.
+ */
+export const RangeHeader: FC<{
+  value: string;
+  onChange: (value: string) => void;
+  options: RangeOption[];
+  rangeAria: string;
+  grafanaUrl: string;
+  grafanaHours: number;
+  grafanaLabel: string;
+}> = ({ value, onChange, options, rangeAria, grafanaUrl, grafanaHours, grafanaLabel }) => (
+  <Group gap="sm" wrap="wrap">
+    <SegmentedControl size="sm" value={value} onChange={onChange} data={options} aria-label={rangeAria} />
+    <Button
+      size="sm"
+      variant="subtle"
+      color="gray"
+      component="a"
+      href={grafana.withRange(grafanaUrl, grafanaHours)}
+      target="_blank"
+      rel="noopener"
+      rightSection={<IconExternal width={14} height={14} />}
+    >
+      {grafanaLabel}
+    </Button>
+  </Group>
+);
