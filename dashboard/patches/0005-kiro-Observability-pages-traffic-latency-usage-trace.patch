+/** The "Traffic" observability page: requests, status codes, routes and bandwidth. */
+import { AreaChart, DonutChart, LineChart } from '@mantine/charts';
+import { Badge, Box, Grid, Group, SimpleGrid, Skeleton, Stack, Table, Text } from '@mantine/core';
+import { useMemo, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+
+import { PortalPageHeader } from '@/kiro/shell/Page';
+
+import { fmtNumber } from '../../guardrails/format';
+import { KpiCard } from '../../guardrails/overview/KpiCard';
+import { EmptyState, ErrorState, SectionCard } from '../../guardrails/ui';
+import { grafana, useTraffic } from '../api';
+import {
+  fmtBytesPerSec,
+  type RangeHours,
+  routeSeries,
+  seriesHasData,
+  sparkFrom,
+  statusColor,
+  toChartRows,
+} from './data';
+import { RangeHeader } from './RangeHeader';
+
+const CHART_H = 260;
+
+export const TrafficPage = () => {
+  const { t, i18n } = useTranslation();
+  const [hours, setHours] = useState<RangeHours>(1);
+  const traffic = useTraffic(hours);
+  const d = traffic.data;
+  const lang = i18n.language;
+  const num = (n: number | null | undefined) => fmtNumber(n, lang);
+
+  const byRouteRows = useMemo(() => toChartRows(d?.per_minute_by_route, hours, lang), [d, hours, lang]);
+  const byCodeRows = useMemo(() => toChartRows(d?.per_minute_by_code, hours, lang), [d, hours, lang]);
+  const bandwidthRows = useMemo(() => toChartRows(d?.bandwidth_bytes_per_s, hours, lang), [d, hours, lang]);
+
+  const routeChartSeries = useMemo(
+    () => routeSeries(d?.per_minute_by_route.series ?? []),
+    [d]
+  );
+  const codeChartSeries = useMemo(
+    () =>
+      (d?.per_minute_by_code.series ?? []).map((code) => ({
+        name: code,
+        label: code,
+        color: statusColor(code),
+      })),
+    [d]
+  );
+
+  const totalRequests = d?.routes.reduce((a, r) => a + r.requests, 0) ?? 0;
+  const donutData = useMemo(
+    () =>
+      (d?.codes ?? []).map((c) => ({
+        name: c.code,
+        value: c.requests,
+        color: statusColor(c.code),
+      })),
+    [d]
+  );
+
+  const codeMeaning = (code: string): string => {
+    switch (code) {
+      case '200':
+        return t('kiro.traffic.codeMeaning.ok');
+      case '400':
+        return t('kiro.traffic.codeMeaning.badRequest');
+      case '401':
+        return t('kiro.traffic.codeMeaning.unauth');
+      case '403':
+        return t('kiro.traffic.codeMeaning.blocked');
+      case '404':
+        return t('kiro.traffic.codeMeaning.notFound');
+      case '429':
+        return t('kiro.traffic.codeMeaning.limited');
+      case '499':
+        return t('kiro.traffic.codeMeaning.clientClosed');
+      default:
+        return code.startsWith('5') ? t('kiro.traffic.codeMeaning.serverError') : code;
+    }
+  };
+
+  const header = (
+    <RangeHeader hours={hours} onChange={setHours} grafanaUrl={grafana.traffic} />
+  );
+
+  if (traffic.error) {
+    return (
+      <Box maw={1440}>
+        <PortalPageHeader title={t('kiro.traffic.title')} subtitle={t('kiro.traffic.subtitle')} actions={header} />
+        <SectionCard title={t('kiro.traffic.title')}>
+          <ErrorState error={traffic.error} />
+        </SectionCard>
+      </Box>
+    );
+  }
+
+  const loading = traffic.isPending;
+
+  return (
+    <Box maw={1440}>
+      <PortalPageHeader title={t('kiro.traffic.title')} subtitle={t('kiro.traffic.subtitle')} actions={header} />
+
+      <Stack gap="md">
+        <SimpleGrid cols={{ base: 1, sm: 2, lg: 4 }} spacing="md">
+          <KpiCard
+            label={t('kiro.traffic.kpi.requests')}
+            value={num(d?.totals.total)}
+            note={t('kiro.traffic.kpi.requestsNote')}
+            spark={sparkFrom(d?.per_minute_by_code, '200')}
+            color="teal.5"
+            loading={loading}
+          />
+          <KpiCard
+            label={t('kiro.traffic.kpi.blocked')}
+            value={num(d?.totals.blocked_403)}
+            note={t('kiro.traffic.kpi.blockedNote')}
+            spark={sparkFrom(d?.per_minute_by_code, '403')}
