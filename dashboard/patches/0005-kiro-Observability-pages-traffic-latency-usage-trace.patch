+/** The "Latency" observability page: where the time goes, p50/p95 by route, gateway vs upstream. */
+import { LineChart } from '@mantine/charts';
+import {
+  Badge,
+  Box,
+  Grid,
+  Group,
+  Progress,
+  SegmentedControl,
+  SimpleGrid,
+  Skeleton,
+  Stack,
+  Table,
+  Text,
+} from '@mantine/core';
+import { useMemo, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+
+import { PortalPageHeader } from '@/kiro/shell/Page';
+
+import { fmtMs, fmtNumber } from '../../guardrails/format';
+import { KpiCard } from '../../guardrails/overview/KpiCard';
+import { EmptyState, ErrorState, SectionCard } from '../../guardrails/ui';
+import { grafana, useLatency } from '../api';
+// RangeHeader is shared from the sibling traffic page per the stage brief.
+import { type RangeHours, routeSeries, seriesHasData, toChartRows } from '../traffic/data';
+import { RangeHeader } from '../traffic/RangeHeader';
+
+const CHART_H = 260;
+
+/** Latency badge colour: >5s red, >1s yellow, otherwise green. */
+const latencyColor = (ms: number | null | undefined): string =>
+  ms == null ? 'gray' : ms > 5000 ? 'red' : ms > 1000 ? 'yellow' : 'teal';
+
+export const LatencyPage = () => {
+  const { t, i18n } = useTranslation();
+  const [hours, setHours] = useState<RangeHours>(1);
+  const [pct, setPct] = useState<'p50' | 'p95'>('p95');
+  const latency = useLatency(hours);
+  const d = latency.data;
+  const lang = i18n.language;
+  const num = (n: number | null | undefined) => fmtNumber(n, lang);
+
+  const byRouteSeries = pct === 'p95' ? d?.p95_by_route : d?.p50_by_route;
+  const byRouteRows = useMemo(() => toChartRows(byRouteSeries, hours, lang), [byRouteSeries, hours, lang]);
+  const routeChartSeries = useMemo(() => routeSeries(byRouteSeries?.series ?? []), [byRouteSeries]);
+
+  const gwVsUpRows = useMemo(() => toChartRows(d?.p95_gateway_vs_upstream, hours, lang), [d, hours, lang]);
+
+  // "Where the time goes" split: gateway p95 vs upstream p95.
+  const gw = d?.gateway_overhead_ms.p95 ?? 0;
+  const up = d?.upstream_p95_ms ?? 0;
+  const total = gw + up;
+  const gwShare = total > 0 ? (gw / total) * 100 : 0;
+  const upShare = total > 0 ? (up / total) * 100 : 0;
+
+  const header = <RangeHeader hours={hours} onChange={setHours} grafanaUrl={grafana.latency} />;
+
+  if (latency.error) {
+    return (
+      <Box maw={1440}>
+        <PortalPageHeader title={t('kiro.latency.title')} subtitle={t('kiro.latency.subtitle')} actions={header} />
+        <SectionCard title={t('kiro.latency.title')}>
+          <ErrorState error={latency.error} />
+        </SectionCard>
+      </Box>
+    );
+  }
+
+  const loading = latency.isPending;
+
+  const pctToggle = (
+    <SegmentedControl
+      size="xs"
+      value={pct}
+      onChange={(v) => setPct(v as 'p50' | 'p95')}
+      aria-label={t('kiro.latency.pctToggle.aria')}
+      data={[
+        { value: 'p50', label: t('kiro.latency.pctToggle.p50') },
+        { value: 'p95', label: t('kiro.latency.pctToggle.p95') },
+      ]}
+    />
+  );
+
+  return (
+    <Box maw={1440}>
+      <PortalPageHeader title={t('kiro.latency.title')} subtitle={t('kiro.latency.subtitle')} actions={header} />
+
+      <Stack gap="md">
+        <SimpleGrid cols={{ base: 1, sm: 2, lg: 3 }} spacing="md">
+          <KpiCard
+            label={t('kiro.latency.kpi.chat')}
+            value={d?.kiro_chat_ms ? `${fmtMs(d.kiro_chat_ms.p50)} / ${fmtMs(d.kiro_chat_ms.p95)}` : '–'}
+            note={t('kiro.latency.kpi.chatNote')}
+            color="violet.5"
+            loading={loading}
+          />
+          <KpiCard
+            label={t('kiro.latency.kpi.gateway')}
+            value={
+              d?.gateway_overhead_ms
+                ? `${fmtMs(d.gateway_overhead_ms.p50)} / ${fmtMs(d.gateway_overhead_ms.p95)}`
+                : '–'
+            }
+            note={t('kiro.latency.kpi.gatewayNote')}
+            color="teal.5"
+            loading={loading}
+          />
+          <KpiCard
+            label={t('kiro.latency.kpi.upstream')}
+            value={fmtMs(d?.upstream_p95_ms)}
+            note={t('kiro.latency.kpi.upstreamNote')}
+            color="orange.5"
+            loading={loading}
+          />
+        </SimpleGrid>
+
+        <SectionCard title={t('kiro.latency.split.title')} hint={t('kiro.latency.split.hint')}>
+          {loading ? (
+            <Skeleton height={90} radius="sm" />
+          ) : total <= 0 ? (
+            <EmptyState title={t('kiro.latency.empty.title')} body={t('kiro.latency.empty.body')} />
+          ) : (
+            <Stack gap="sm">
+              <Progress.Root size={28} radius="sm">
+                <Progress.Section value={gwShare} color="teal.5">
+                  <Progress.Label>{t('kiro.latency.split.gateway')}</Progress.Label>
+                </Progress.Section>
+                <Progress.Section value={upShare} color="orange.5">
+                  <Progress.Label>{t('kiro.latency.split.upstream')}</Progress.Label>
+                </Progress.Section>
+              </Progress.Root>
+              <Group justify="space-between">
+                <Group gap={6}>
+                  <Badge color="teal" variant="light" radius="sm">
+                    {t('kiro.latency.split.gateway')}
+                  </Badge>
+                  <Text size="sm" fw={600} style={{ fontVariantNumeric: 'tabular-nums' }}>
+                    {fmtMs(gw)}
+                  </Text>
+                </Group>
+                <Group gap={6}>
+                  <Badge color="orange" variant="light" radius="sm">
+                    {t('kiro.latency.split.upstream')}
+                  </Badge>
+                  <Text size="sm" fw={600} style={{ fontVariantNumeric: 'tabular-nums' }}>
+                    {fmtMs(up)}
+                  </Text>
+                </Group>
+              </Group>
+              <Text size="xs" c="dimmed">
+                {t('kiro.latency.split.explain', { gw: fmtMs(gw), up: fmtMs(up) })}
+              </Text>
+            </Stack>
+          )}
+        </SectionCard>
+
+        <Grid gutter="md">
+          <Grid.Col span={{ base: 12, lg: 7 }}>
+            <SectionCard
+              title={t('kiro.latency.byRoute.title')}
+              hint={t('kiro.latency.byRoute.hint')}
+              action={pctToggle}
+            >
+              {loading ? (
+                <Skeleton height={CHART_H} radius="sm" />
+              ) : !seriesHasData(byRouteSeries) ? (
+                <EmptyState title={t('kiro.latency.empty.title')} body={t('kiro.latency.empty.body')} />
+              ) : (
+                <LineChart
+                  h={CHART_H}
+                  data={byRouteRows}
+                  dataKey="label"
+                  withLegend
+                  curveType="monotone"
+                  valueFormatter={(v) => fmtMs(v)}
+                  series={routeChartSeries}
+                />
+              )}
+            </SectionCard>
+          </Grid.Col>
+
+          <Grid.Col span={{ base: 12, lg: 5 }}>
+            <SectionCard title={t('kiro.latency.gwVsUp.title')} hint={t('kiro.latency.gwVsUp.hint')} h="100%">
+              {loading ? (
+                <Skeleton height={CHART_H} radius="sm" />
+              ) : !seriesHasData(d?.p95_gateway_vs_upstream) ? (
+                <EmptyState title={t('kiro.latency.empty.title')} body={t('kiro.latency.empty.body')} />
+              ) : (
+                <LineChart
+                  h={CHART_H}
+                  data={gwVsUpRows}
+                  dataKey="label"
+                  withLegend
+                  curveType="monotone"
+                  valueFormatter={(v) => fmtMs(v)}
+                  series={[
+                    { name: 'Gateway', label: t('kiro.latency.split.gateway'), color: 'teal.5' },
+                    { name: 'Upstream (Kiro / AWS)', label: t('kiro.latency.split.upstream'), color: 'orange.5' },
+                  ]}
+                />
+              )}
+            </SectionCard>
+          </Grid.Col>
+
+          <Grid.Col span={12}>
+            <SectionCard title={t('kiro.latency.routes.title')} hint={t('kiro.latency.routes.hint')}>
+              {loading ? (
+                <Skeleton height={CHART_H} radius="sm" />
+              ) : !d || d.routes.length === 0 ? (
+                <EmptyState title={t('kiro.latency.empty.title')} />
+              ) : (
+                <Table verticalSpacing="xs" fz="sm">
+                  <Table.Thead>
+                    <Table.Tr>
+                      <Table.Th>{t('kiro.latency.routes.name')}</Table.Th>
+                      <Table.Th>{t('kiro.latency.routes.id')}</Table.Th>
+                      <Table.Th ta="right">{t('kiro.latency.routes.p50')}</Table.Th>
+                      <Table.Th ta="right">{t('kiro.latency.routes.p95')}</Table.Th>
+                      <Table.Th ta="right">{t('kiro.latency.routes.requests')}</Table.Th>
+                    </Table.Tr>
+                  </Table.Thead>
+                  <Table.Tbody>
+                    {d.routes.map((r) => (
+                      <Table.Tr key={r.id}>
+                        <Table.Td fw={500}>{r.route}</Table.Td>
+                        <Table.Td>
+                          <Text span ff="monospace" size="xs" c="dimmed">
+                            {r.id}
+                          </Text>
+                        </Table.Td>
+                        <Table.Td ta="right" style={{ fontVariantNumeric: 'tabular-nums' }}>
+                          {fmtMs(r.p50)}
+                        </Table.Td>
+                        <Table.Td ta="right">
+                          <Badge color={latencyColor(r.p95)} variant="light" radius="sm">
+                            {fmtMs(r.p95)}
+                          </Badge>
+                        </Table.Td>
+                        <Table.Td ta="right" style={{ fontVariantNumeric: 'tabular-nums' }}>
+                          {num(r.requests)}
+                        </Table.Td>
+                      </Table.Tr>
+                    ))}
+                  </Table.Tbody>
+                </Table>
+              )}
+            </SectionCard>
+          </Grid.Col>
+        </Grid>
+      </Stack>
+    </Box>
+  );
+};
