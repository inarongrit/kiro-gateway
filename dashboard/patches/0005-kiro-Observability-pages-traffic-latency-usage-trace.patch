+/** Right-side Drawer with the full detail + waterfall for one trace. */
+import {
+  ActionIcon,
+  Badge,
+  Box,
+  Collapse,
+  CopyButton,
+  Drawer,
+  Group,
+  Skeleton,
+  Stack,
+  Table,
+  Text,
+  Tooltip,
+  UnstyledButton,
+} from '@mantine/core';
+import { useDisclosure } from '@mantine/hooks';
+import { useState } from 'react';
+import { useTranslation } from 'react-i18next';
+
+import { grafana, type Span, useTrace } from '@/kiro/observability/api';
+import IconCheck from '~icons/tabler/check';
+import IconChevron from '~icons/tabler/chevron-right';
+import IconCopy from '~icons/tabler/copy';
+import IconExternal from '~icons/tabler/external-link';
+
+import { fmtMs } from '../../guardrails/format';
+import { EmptyState, ErrorState } from '../../guardrails/ui';
+import { buildWaterfall, phaseColor, shortSpanName, statusColor, useHostLabel, workSplit } from './data';
+
+const CopyChip = ({ value, label }: { value: string; label: string }) => (
+  <CopyButton value={value} timeout={1500}>
+    {({ copied, copy }) => (
+      <Tooltip label={label} withArrow>
+        <ActionIcon variant="subtle" color={copied ? 'teal' : 'gray'} onClick={copy} aria-label={label} size="sm">
+          {copied ? <IconCheck width={14} height={14} /> : <IconCopy width={14} height={14} />}
+        </ActionIcon>
+      </Tooltip>
+    )}
+  </CopyButton>
+);
+
+/** Flat key/value table used for span and request attributes. */
+const AttrTable = ({ attrs }: { attrs: Record<string, string | number | boolean | null> }) => {
+  const entries = Object.entries(attrs);
+  if (entries.length === 0) return null;
+  return (
+    <Table withTableBorder verticalSpacing={4} fz="xs">
+      <Table.Tbody>
+        {entries.map(([k, v]) => (
+          <Table.Tr key={k}>
+            <Table.Td w="40%">
+              <Text span ff="monospace" size="xs" c="dimmed">
+                {k}
+              </Text>
+            </Table.Td>
+            <Table.Td>
+              <Text span ff="monospace" size="xs" style={{ wordBreak: 'break-all' }}>
+                {String(v)}
+              </Text>
+            </Table.Td>
+          </Table.Tr>
+        ))}
+      </Table.Tbody>
+    </Table>
+  );
+};
+
+const SpanRow = ({ span, depth, total }: { span: Span; depth: number; total: number }) => {
+  const [open, setOpen] = useState(false);
+  const left = total > 0 ? (span.offset_ms / total) * 100 : 0;
+  const width = total > 0 ? Math.max((span.duration_ms / total) * 100, 0.2) : 0;
+  const hasAttrs = Object.keys(span.attributes).length > 0;
+  const short = shortSpanName(span.name);
+  return (
+    <Box>
+      <UnstyledButton
+        onClick={() => hasAttrs && setOpen((o) => !o)}
+        style={{ display: 'block', width: '100%', cursor: hasAttrs ? 'pointer' : 'default' }}
+      >
+        <Group gap={6} wrap="nowrap" py={3} style={{ paddingLeft: depth * 14 }}>
+          <IconChevron
+            width={12}
+            height={12}
+            style={{
+              opacity: hasAttrs ? 0.6 : 0,
+              transform: open ? 'rotate(90deg)' : 'none',
+              transition: 'transform 120ms',
+              flexShrink: 0,
+            }}
+          />
+          <Tooltip label={span.name} withArrow openDelay={300} disabled={short === span.name}>
+            <Text span ff="monospace" size="xs" style={{ flex: '0 0 42%', overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>
+              {short}
+            </Text>
+          </Tooltip>
+          <Box style={{ position: 'relative', flex: 1, height: 14 }}>
+            <Box
+              style={{
+                position: 'absolute',
+                left: `${left}%`,
+                width: `${width}%`,
+                minWidth: 2,
+                top: 3,
+                height: 8,
+                borderRadius: 4,
+              }}
+              bg={phaseColor(span.name)}
+            />
+          </Box>
+          <Text span size="xs" c="dimmed" ff="monospace" style={{ flexShrink: 0, width: 64, textAlign: 'right' }}>
+            {fmtMs(span.duration_ms)}
+          </Text>
+        </Group>
+      </UnstyledButton>
+      {hasAttrs && (
+        <Collapse in={open}>
+          <Box pl={depth * 14 + 18} pb={6}>
+            <AttrTable attrs={span.attributes} />
+          </Box>
+        </Collapse>
+      )}
+    </Box>
+  );
+};
+
+export const TraceDrawer = ({ traceId, onClose }: { traceId: string | null; onClose: () => void }) => {
+  const { t } = useTranslation();
+  const [attrsOpen, { toggle: toggleAttrs }] = useDisclosure(false);
+  const hostLabel = useHostLabel();
+  const q = useTrace(traceId);
+  const d = q.data;
+  const is404 =
+    q.error instanceof Error && /\b404\b/.test(q.error.message);
+
+  const total = d?.duration_ms ?? 0;
+  const rootStatus = d ? Number(d.attributes['http.status_code'] ?? d.attributes['http.response.status_code'] ?? NaN) : NaN;
+  const host = d ? String(d.attributes['net.host.name'] ?? '') : '';
+  const hostFriendly = host ? hostLabel(host) : null;
+  const split = d ? workSplit(d.spans, total) : null;
+  const waterfall = d ? buildWaterfall(d.spans) : [];
+
+  return (
+    <Drawer
+      opened={traceId != null}
+      onClose={onClose}
+      position="right"
+      size="xl"
+      title={<Text fw={600}>{t('kiro.traces.detail.title')}</Text>}
+    >
+      {q.isPending ? (
+        <Stack gap="md">
+          <Skeleton height={60} radius="sm" />
+          <Skeleton height={320} radius="sm" />
+        </Stack>
+      ) : is404 ? (
+        <EmptyState title={t('kiro.traces.detail.goneTitle')} body={t('kiro.traces.detail.goneBody')} />
+      ) : q.error ? (
+        <ErrorState error={q.error} />
+      ) : d ? (
+        <Stack gap="lg">
+          <Stack gap="xs">
+            <Group gap="sm" wrap="wrap">
+              <Text ff="monospace" fw={600}>
+                {d.root}
+              </Text>
+              {Number.isFinite(rootStatus) && (
+                <Badge color={statusColor(rootStatus)} variant="light" radius="sm">
+                  {rootStatus}
+                </Badge>
+              )}
+            </Group>
+            <Group gap="md" wrap="wrap">
+              <Text size="sm">
+                <Text span c="dimmed" size="sm">
+                  {t('kiro.traces.detail.total')}:{' '}
+                </Text>
+                <Text span fw={600}>
+                  {fmtMs(total)}
+                </Text>
+              </Text>
+              {host && (
+                <Text size="sm">
+                  <Text span c="dimmed" size="sm">
+                    {t('kiro.traces.detail.host')}:{' '}
+                  </Text>
+                  {hostFriendly ? hostFriendly.label : host}{' '}
+                  {hostFriendly && (
+                    <Text span c="dimmed" size="xs" ff="monospace">
+                      {hostFriendly.raw}
+                    </Text>
+                  )}
+                </Text>
+              )}
+            </Group>
+            <Group gap={6} wrap="nowrap">
+              <Text span c="dimmed" size="xs">
+                {t('kiro.traces.detail.traceId')}:
+              </Text>
+              <Text span ff="monospace" size="xs" style={{ wordBreak: 'break-all' }}>
+                {d.trace_id}
+              </Text>
+              <CopyChip value={d.trace_id} label={t('kiro.traces.detail.copyId')} />
+            </Group>
+            <Group gap="xs">
+              <Text
+                component="a"
+                href={grafana.trace(d.trace_id)}
+                target="_blank"
+                rel="noopener"
+                size="sm"
+                c="blue"
+              >
+                <Group gap={4} wrap="nowrap" component="span">
+                  {t('kiro.traces.detail.openGrafana')}
+                  <IconExternal width={13} height={13} />
+                </Group>
+              </Text>
+            </Group>
+          </Stack>
+
+          {split && (
+            <Text size="sm" c="dimmed">
+              {split.upstream == null
+                ? t('kiro.traces.detail.workGatewayOnly', { gateway: fmtMs(split.gateway) })
+                : t('kiro.traces.detail.work', {
+                    gateway: fmtMs(split.gateway),
+                    upstream: fmtMs(split.upstream),
+                  })}
+            </Text>
+          )}
+
+          <Box>
+            <Text fw={600} size="sm" mb="xs">
+              {t('kiro.traces.detail.waterfall')}
+            </Text>
+            <Stack gap={0}>
+              {waterfall.map(({ span, depth }) => (
+                <SpanRow key={span.id} span={span} depth={depth} total={total} />
+              ))}
+            </Stack>
+          </Box>
+
+          {Object.keys(d.attributes).length > 0 && (
+            <Box>
+              <UnstyledButton onClick={toggleAttrs} aria-label={t('kiro.traces.detail.requestAttrs')}>
+                <Group gap={6} wrap="nowrap">
+                  <IconChevron
+                    width={13}
+                    height={13}
+                    style={{ transform: attrsOpen ? 'rotate(90deg)' : 'none', transition: 'transform 120ms' }}
+                  />
+                  <Text fw={600} size="sm">
+                    {t('kiro.traces.detail.requestAttrs')}
+                  </Text>
+                </Group>
+              </UnstyledButton>
+              <Collapse in={attrsOpen}>
+                <Box mt="xs">
+                  <AttrTable attrs={d.attributes} />
+                </Box>
+              </Collapse>
+            </Box>
+          )}
+        </Stack>
+      ) : null}
+    </Drawer>
+  );
+};
