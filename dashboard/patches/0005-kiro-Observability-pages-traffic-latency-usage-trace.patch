+/** Pure data helpers for the Traces page: ranges, host/status/phase mapping, waterfall tree. */
+import { useTranslation } from 'react-i18next';
+
+import type { Span } from '@/kiro/observability/api';
+
+/** Selectable trace windows, in hours (15m / 1h / 6h / 24h). */
+export type TraceHours = 0.25 | 1 | 6 | 24;
+
+/** A friendly label for a known gateway host, plus the raw host to show dimmed. null = unknown. */
+export type HostLabel = { label: string; raw: string } | null;
+
+/**
+ * Resolve a host string to a friendly label (static i18n keys so the key type checks).
+ * Returns null for hosts we have no label for — callers then show the raw host only.
+ */
+export const useHostLabel = () => {
+  const { t } = useTranslation();
+  return (host: string): HostLabel => {
+    switch (host) {
+      case 'runtime.us-east-1.kiro.dev':
+        return { label: t('kiro.traces.host.kiroChat'), raw: host };
+      case 'q.us-east-1.amazonaws.com':
+        return { label: t('kiro.traces.host.kiroApi'), raw: host };
+      case 'management.us-east-1.kiro.dev':
+        return { label: t('kiro.traces.host.kiroAccount'), raw: host };
+      case '127.0.0.1':
+        return { label: t('kiro.traces.host.aiRoute'), raw: host };
+      default:
+        return null;
+    }
+  };
+};
+
+/** Map an HTTP status (or null) to a theme colour, consistent with the rest of the console. */
+export const statusColor = (status: number | null): string => {
+  if (status == null) return 'gray';
+  if (status === 403) return 'red';
+  if (status === 429) return 'orange';
+  if (status === 499) return 'gray';
+  if (status >= 500) return 'red.8';
+  if (status >= 400) return 'yellow';
+  if (status >= 300) return 'blue';
+  if (status >= 200) return 'teal';
+  return 'gray';
+};
+
+/** Colour a span bar by the APISIX phase embedded in its name. */
+export const phaseColor = (name: string): string => {
+  const n = name.toLowerCase();
+  if (n.includes('access') || n.includes('rewrite')) return 'violet.5';
+  if (n.includes('upstream') || n.includes('balancer') || n.includes('proxy')) return 'blue.5';
+  if (n.includes('header_filter') || n.includes('body_filter') || n.includes('log')) return 'gray.5';
+  return 'teal.5';
+};
+
+/** Drop the noisy "apisix.phase." prefix for display (full name stays in the tooltip). */
+export const shortSpanName = (name: string): string => name.replace(/^apisix\.phase\./, '');
+
+/** A span annotated with its tree depth, in render (offset) order. */
+export type WaterfallRow = { span: Span; depth: number };
+
+/**
+ * Build a depth-annotated, offset-ordered list of spans from the flat id/parent list.
+ * Children are visited in ascending offset so the waterfall reads top-to-bottom in time.
+ */
+export const buildWaterfall = (spans: Span[]): WaterfallRow[] => {
+  const byParent = new Map<string, Span[]>();
+  const ids = new Set(spans.map((s) => s.id));
+  for (const s of spans) {
+    const parent = s.parent && ids.has(s.parent) ? s.parent : '';
+    const list = byParent.get(parent) ?? [];
+    list.push(s);
+    byParent.set(parent, list);
+  }
+  for (const list of byParent.values()) list.sort((a, b) => a.offset_ms - b.offset_ms);
+
+  const out: WaterfallRow[] = [];
+  const walk = (parent: string, depth: number) => {
+    for (const s of byParent.get(parent) ?? []) {
+      out.push({ span: s, depth });
+      walk(s.id, depth + 1);
+    }
+  };
+  walk('', 0);
+  // Any spans whose parent was pruned still deserve a row (defensive).
+  if (out.length < spans.length) {
+    const seen = new Set(out.map((r) => r.span.id));
+    for (const s of spans) if (!seen.has(s.id)) out.push({ span: s, depth: 0 });
+  }
+  return out;
+};
+
+/** Best-effort gateway-vs-upstream-wait split from span names. Returns null wait if none match. */
+export const workSplit = (spans: Span[], total: number): { gateway: number; upstream: number | null } => {
+  const isUpstream = (name: string) => {
+    const n = name.toLowerCase();
+    return n.includes('upstream') || n.includes('proxy') || n.includes('balancer');
+  };
+  const upstreamSpans = spans.filter((s) => isUpstream(s.name));
+  if (upstreamSpans.length === 0) return { gateway: total, upstream: null };
+  const upstream = Math.max(...upstreamSpans.map((s) => s.duration_ms));
+  return { gateway: Math.max(0, total - upstream), upstream };
+};
