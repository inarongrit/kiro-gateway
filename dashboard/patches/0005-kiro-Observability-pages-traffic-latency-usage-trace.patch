+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+/** Pure data helpers shared by the Traffic and Latency observability pages. */
+import type { Series } from '../api';
+
+/** The selectable time windows, in hours (1h / 6h / 24h / 7d). */
+export type RangeHours = 1 | 6 | 24 | 168;
+export const RANGE_HOURS: RangeHours[] = [1, 6, 24, 168];
+
+/** A chart row with a derived, localized `label` column for the x axis. */
+export type ChartRow = { label: string } & Record<string, number | null | string>;
+
+/** Format an epoch-ms x value: hour:minute for short windows, short date for 7d. */
+export const axisLabel = (t: number, daily: boolean, lang?: string): string =>
+  daily
+    ? new Intl.DateTimeFormat(lang, { month: 'short', day: 'numeric', hour: '2-digit' }).format(new Date(t))
+    : new Intl.DateTimeFormat(lang, { hour: '2-digit', minute: '2-digit' }).format(new Date(t));
+
+/** Turn an API Series into recharts-ready rows with a localized `label` x-axis field. */
+export const toChartRows = (series: Series | undefined, hours: number, lang?: string): ChartRow[] => {
+  if (!series) return [];
+  const daily = hours >= 168;
+  return series.rows.map((row) => {
+    const { t, ...rest } = row;
+    return { label: axisLabel(t, daily, lang), ...rest } as ChartRow;
+  });
+};
+
+/** True when at least one series carries a non-zero value across the window. */
+export const seriesHasData = (series: Series | undefined): boolean =>
+  !!series &&
+  series.rows.some((row) => series.series.some((name) => typeof row[name] === 'number' && (row[name] as number) > 0));
+
+/** Flat sparkline array for one series name. */
+export const sparkFrom = (series: Series | undefined, name: string): number[] =>
+  series ? series.rows.map((row) => (typeof row[name] === 'number' ? (row[name] as number) : 0)) : [];
+
+/** Human-readable bytes/second (e.g. 1.2 kB/s, 3.4 MB/s). Null -> en-dash. */
+export const fmtBytesPerSec = (n: number | null | undefined): string => {
+  if (n == null) return '–';
+  if (n < 1) return '0 B/s';
+  const units = ['B/s', 'kB/s', 'MB/s', 'GB/s', 'TB/s'];
+  const i = Math.min(units.length - 1, Math.floor(Math.log(n) / Math.log(1000)));
+  const v = n / 1000 ** i;
+  return `${i === 0 ? Math.round(v) : v.toFixed(1)} ${units[i]}`;
+};
+
+/** Consistent HTTP status-class -> theme colour mapping used by every chart. */
+export const statusColor = (code: string): string => {
+  if (code === '403') return 'red.5';
+  if (code === '429') return 'orange.5';
+  if (code === '499') return 'gray.5';
+  if (code.startsWith('2')) return 'teal.5';
+  if (code.startsWith('3')) return 'blue.5';
+  if (code.startsWith('4')) return 'yellow.5';
+  if (code.startsWith('5')) return 'red.8';
+  return 'gray.5';
+};
+
+/** Fixed palette for route series (stable across charts on a page). */
+export const ROUTE_COLORS = ['violet.5', 'teal.5', 'blue.5', 'cyan.5', 'orange.5', 'yellow.5', 'gray.5'] as const;
+
+/** Assign a colour to each route series name by position. */
+export const routeSeries = (names: string[]): { name: string; color: string }[] =>
+  names.map((name, i) => ({ name, color: ROUTE_COLORS[i % ROUTE_COLORS.length] }));
