+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+import { createTheme, MantineProvider, mergeThemeOverrides } from '@mantine/core';
+import { type ReactNode, useMemo } from 'react';
+import { useTranslation } from 'react-i18next';
+
+import { portalCssVariables, portalTheme } from './theme';
+
+/** Portal theme plus translated accessible names for icon-only close buttons. */
+export const ThemedProvider = ({ children }: { children: ReactNode }) => {
+  const { t } = useTranslation();
+  const theme = useMemo(() => {
+    const closeButtonProps = { 'aria-label': t('kiro.common.close') };
+    return mergeThemeOverrides(
+      portalTheme,
+      createTheme({
+        components: {
+          Modal: { defaultProps: { closeButtonProps } },
+          Drawer: { defaultProps: { closeButtonProps } },
+          Notification: { defaultProps: { closeButtonProps } },
+        },
+      })
+    );
+  }, [t]);
+  return (
+    <MantineProvider theme={theme} defaultColorScheme="dark" cssVariablesResolver={portalCssVariables}>
+      {children}
+    </MantineProvider>
+  );
+};
