+import {
+  AppShell,
+  Badge,
+  Box,
+  CloseButton,
+  Group,
+  NavLink,
+  ScrollArea,
+  Stack,
+  Text,
+  ThemeIcon,
+  Tooltip,
+  UnstyledButton,
+} from '@mantine/core';
+import { Link, useRouterState } from '@tanstack/react-router';
+import type { FC } from 'react';
+import { useTranslation } from 'react-i18next';
+
+import type { NavRoute } from '@/config/navRoutes';
+import { groupLabel, itemLabel, navGroups, type PortalNavItem } from '@/kiro/nav';
+import IconChevronsLeft from '~icons/tabler/layout-sidebar-left-collapse';
+import IconChevronsRight from '~icons/tabler/layout-sidebar-left-expand';
+import IconShield from '~icons/tabler/shield-check';
+
+import classes from './shell.module.css';
+
+export const BrandMark: FC<{ size?: number }> = ({ size = 28 }) => (
+  <ThemeIcon
+    size={size}
+    radius="md"
+    variant="gradient"
+    gradient={{ from: 'indigo.4', to: 'violet.5', deg: 135 }}
+    aria-hidden
+  >
+    <IconShield width={size * 0.6} height={size * 0.6} />
+  </ThemeIcon>
+);
+
+const isActive = (pathname: string, to: string) =>
+  pathname === `/ui${to}` || pathname.startsWith(`/ui${to}/`) || pathname === to || pathname.startsWith(`${to}/`);
+
+type Props = { collapsed: boolean; onToggleCollapsed: () => void; onNavigate: () => void };
+
+export const PortalNavbar: FC<Props> = ({ collapsed, onToggleCollapsed, onNavigate }) => {
+  const { t } = useTranslation();
+  const pathname = useRouterState({ select: (s) => s.location.pathname });
+
+  return (
+    <AppShell.Navbar className={classes.navbar} data-collapsed={collapsed || undefined}>
+      <Group className={classes.brand} wrap="nowrap" gap="sm">
+        <BrandMark />
+        {!collapsed && (
+          <>
+            <Box style={{ lineHeight: 1.15 }}>
+              <Text fw={650} size="md">
+                {t('kiro.brand.name')}
+              </Text>
+              <Text size="xs" c="dimmed">
+                {t('kiro.brand.tagline')}
+              </Text>
+            </Box>
+            <Badge size="xs" ml="auto" variant="light">
+              {t('kiro.brand.poc')}
+            </Badge>
+            <CloseButton hiddenFrom="sm" onClick={onNavigate} aria-label={t('a11y.toggleNavigation')} />
+          </>
+        )}
+      </Group>
+
+      <ScrollArea className={classes.scroll} type="hover" scrollbarSize={6}>
+        <nav aria-label={t('kiro.brand.name')}>
+          {navGroups.map((group) => (
+            <Box key={group.id} className={classes.group}>
+              {group.label && !collapsed && (
+                <Text className={classes.groupLabel}>{groupLabel(t, group)}</Text>
+              )}
+              {group.label && collapsed && <div className={classes.groupRule} aria-hidden />}
+              {(group.items as Array<PortalNavItem | NavRoute>).map((item) => {
+                const { icon: Icon } = item;
+                const to = item.to as string;
+                const text = itemLabel(t, group, item);
+                const link = (
+                  <NavLink
+                    key={to}
+                    component={Link}
+                    to={to}
+                    onClick={onNavigate}
+                    label={collapsed ? undefined : text}
+                    aria-label={collapsed ? text : undefined}
+                    active={isActive(pathname, to)}
+                    className={classes.link}
+                    leftSection={<Icon aria-hidden focusable="false" width={18} height={18} />}
+                  />
+                );
+                return collapsed ? (
+                  <Tooltip key={to} label={text} position="right" openDelay={100}>
+                    {link}
+                  </Tooltip>
+                ) : (
+                  link
+                );
+              })}
+            </Box>
+          ))}
+        </nav>
+      </ScrollArea>
+
+      <Stack className={classes.footer} gap="xs">
+        <UnstyledButton
+          className={classes.collapseBtn}
+          onClick={onToggleCollapsed}
+          aria-label={collapsed ? t('kiro.nav.expand') : t('kiro.nav.collapse')}
+          visibleFrom="sm"
+        >
+          {collapsed ? <IconChevronsRight width={18} height={18} /> : <IconChevronsLeft width={18} height={18} />}
+          {!collapsed && <Text size="sm">{t('kiro.nav.collapse')}</Text>}
+        </UnstyledButton>
+      </Stack>
+    </AppShell.Navbar>
+  );
+};
