+/**
+ * Grouped sidebar navigation: Overview · AI Guardrails · Observability · Gateway.
+ * "Gateway" is the upstream APISIX dashboard's own list (config/navRoutes.ts), unchanged.
+ */
+import type { Resources } from '@/config/i18n';
+import type { NavIcon, NavRoute } from '@/config/navRoutes';
+import { navRoutes } from '@/config/navRoutes';
+import IconActivity from '~icons/tabler/activity';
+import IconTraffic from '~icons/tabler/chart-line';
+import IconLatency from '~icons/tabler/clock-hour-4';
+import IconTester from '~icons/tabler/flask';
+import IconOverview from '~icons/tabler/layout-dashboard';
+import IconRules from '~icons/tabler/list-check';
+import IconTraces from '~icons/tabler/timeline';
+import IconUsage from '~icons/tabler/users-group';
+
+/** Portal page: a path under /ui and a key in the `kiro.nav` locale section. */
+export type KiroNavKey = keyof Resources['en']['common']['kiro']['nav'];
+export type KiroPageKey = keyof Resources['en']['common']['kiro']['page'];
+export type PortalNavItem = { to: string; label: KiroNavKey; icon: NavIcon };
+export type NavGroup =
+  | { id: string; label: KiroNavKey | null; kind: 'portal'; items: PortalNavItem[] }
+  | { id: string; label: KiroNavKey; kind: 'gateway'; items: NavRoute[] };
+
+/** One flat, typed entry per page, with its label already resolved by the caller's `t`. */
+export type FlatNavItem = { to: string; icon: NavIcon; label: string; group: string };
+
+type T = (key: `kiro.nav.${KiroNavKey}` | `sources.${NavRoute['label']}`) => string;
+
+export const itemLabel = (t: T, group: NavGroup, i: PortalNavItem | NavRoute) =>
+  group.kind === 'gateway'
+    ? t(`sources.${(i as NavRoute).label}`)
+    : t(`kiro.nav.${(i as PortalNavItem).label}`);
+
+export const groupLabel = (t: T, group: NavGroup) => (group.label ? t(`kiro.nav.${group.label}`) : '');
+
+export const navGroups: NavGroup[] = [
+  {
+    id: 'overview',
+    label: null,
+    kind: 'portal',
+    items: [{ to: '/overview', label: 'overview', icon: IconOverview }],
+  },
+  {
+    id: 'guardrails',
+    label: 'guardrails',
+    kind: 'portal',
+    items: [
+      { to: '/guardrails/rules', label: 'rules', icon: IconRules },
+      { to: '/guardrails/activity', label: 'activity', icon: IconActivity },
+      { to: '/guardrails/tester', label: 'tester', icon: IconTester },
+    ],
+  },
+  {
+    id: 'observability',
+    label: 'observability',
+    kind: 'portal',
+    items: [
+      { to: '/observability/traffic', label: 'traffic', icon: IconTraffic },
+      { to: '/observability/latency', label: 'latency', icon: IconLatency },
+      { to: '/observability/usage', label: 'usage', icon: IconUsage },
+      { to: '/observability/traces', label: 'traces', icon: IconTraces },
+    ],
+  },
+  { id: 'gateway', label: 'gateway', kind: 'gateway', items: navRoutes },
+];
diff --git a/src/kiro/portal.css b/src/kiro/portal.css
new file mode 100644
