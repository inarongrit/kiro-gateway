+import { Box, Card, Group, Stack, Text, ThemeIcon, Title } from '@mantine/core';
+import type { FC, ReactNode } from 'react';
+import { useTranslation } from 'react-i18next';
+
+import type { KiroPageKey } from '@/kiro/nav';
+import IconHammer from '~icons/tabler/hammer';
+
+/** Standard page header for portal pages: title, one-line subtitle, optional actions. */
+export const PortalPageHeader: FC<{ title: string; subtitle?: ReactNode; actions?: ReactNode }> = ({
+  title,
+  subtitle,
+  actions,
+}) => (
+  <Group justify="space-between" align="flex-end" mb="lg" wrap="wrap" gap="md">
+    <Box>
+      <Title order={1}>{title}</Title>
+      {subtitle && (
+        <Text c="dimmed" size="sm" mt={4}>
+          {subtitle}
+        </Text>
+      )}
+    </Box>
+    {actions && <Group gap="sm">{actions}</Group>}
+  </Group>
+);
+
+/** Placeholder for portal pages that later stages fill in. */
+export const ComingSoon: FC<{ page: KiroPageKey }> = ({ page }) => {
+  const { t } = useTranslation();
+  return (
+    <Box maw={1440}>
+      <PortalPageHeader title={t(`kiro.page.${page}.title`)} subtitle={t(`kiro.page.${page}.subtitle`)} />
+      <Card>
+        <Group gap="md" wrap="nowrap" align="flex-start">
+          <ThemeIcon variant="light" size={40} radius="md">
+            <IconHammer width={20} height={20} />
+          </ThemeIcon>
+          <Stack gap={4}>
+            <Text fw={600}>{t('kiro.comingSoon.title')}</Text>
+            <Text c="dimmed" size="sm">
+              {t('kiro.comingSoon.body')}
+            </Text>
+          </Stack>
+        </Group>
+      </Card>
+    </Box>
+  );
+};
