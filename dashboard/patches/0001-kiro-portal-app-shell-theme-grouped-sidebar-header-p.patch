+/**
+ * Client for the Guardrail Console API (same origin, session cookie). Every portal page
+ * outside "Gateway" talks to this; the Admin API keeps using the upstream axios client.
+ */
+export class ConsoleApiError extends Error {
+  constructor(
+    message: string,
+    readonly status: number
+  ) {
+    super(message);
+  }
+}
+
+type Json = Record<string, unknown> | unknown[] | null;
+
+export async function consoleApi<T = unknown>(
+  method: 'GET' | 'POST' | 'PUT',
+  path: string,
+  body?: Json
+): Promise<T> {
+  const headers: Record<string, string> = {};
+  if (method !== 'GET') {
+    headers['X-Console'] = '1'; // CSRF defence required by the console for mutations
+    headers['Content-Type'] = 'application/json';
+  }
+  const res = await fetch(path, {
+    method,
+    headers,
+    credentials: 'same-origin',
+    body: body === undefined ? undefined : JSON.stringify(body),
+  });
+  let data: unknown = null;
+  try {
+    data = await res.json();
+  } catch {
+    /* empty body */
+  }
+  if (res.status === 401) {
+    // Session expired: go through the console sign-in and come back to the portal.
+    window.location.assign('/?next=ui');
+  }
+  if (!res.ok) {
+    const detail = (data as { detail?: unknown } | null)?.detail;
+    const msg = Array.isArray(detail)
+      ? detail.map((d: { msg?: string }) => d.msg).join('; ')
+      : typeof detail === 'string'
+        ? detail
+        : `HTTP ${res.status}`;
+    throw new ConsoleApiError(msg, res.status);
+  }
+  return data as T;
+}
+
+export type GatewayStatus = { healthy: boolean; data_plane: boolean; admin_api: boolean };
+export type Me = { user: string };
+
+export const getStatus = () => consoleApi<GatewayStatus>('GET', '/api/status');
+export const getMe = () => consoleApi<Me>('GET', '/api/me');
+export const signOut = async () => {
+  try {
+    await consoleApi('POST', '/api/logout');
+  } finally {
+    window.location.assign('/');
+  }
+};
