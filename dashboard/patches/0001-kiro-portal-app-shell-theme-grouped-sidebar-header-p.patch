+/**
+ * Kiro Gateway portal theme (dashboard/design/DESIGN.md). Dark by default, light supported.
+ * Mantine's `dark` tuple is remapped to the portal palette so every upstream Mantine component
+ * picks it up without per-page changes.
+ */
+import {
+  createTheme,
+  type CSSVariablesResolver,
+  type MantineColorsTuple,
+  rem,
+} from '@mantine/core';
+
+const indigo: MantineColorsTuple = [
+  '#EEF0FF', '#DDE1FF', '#BAC2FF', '#98A3FF', '#7C8CFF',
+  '#6575F5', '#4C5BD4', '#3D49AE', '#2F3888', '#222863',
+];
+
+// Mantine dark scale: 0 = text … 4 = borders, 5 = hover, 6 = surfaces, 7 = default body.
+const dark: MantineColorsTuple = [
+  '#E8ECF4', '#C5CCDA', '#9AA4B8', '#6B7489', '#2A3346',
+  '#1A2130', '#121722', '#0E121B', '#0B0E14', '#080A0F',
+];
+
+export const portalTheme = createTheme({
+  primaryColor: 'indigo',
+  colors: { indigo, dark },
+  primaryShade: { light: 6, dark: 4 },
+  defaultGradient: { from: 'indigo.5', to: 'violet.6', deg: 135 },
+  fontFamily:
+    '"Inter Variable", Inter, system-ui, -apple-system, "Segoe UI", sans-serif',
+  fontFamilyMonospace:
+    '"JetBrains Mono Variable", "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace',
+  headings: {
+    fontWeight: '650',
+    sizes: {
+      h1: { fontSize: rem(24), lineHeight: '1.25' },
+      h2: { fontSize: rem(20), lineHeight: '1.3' },
+      h3: { fontSize: rem(16), lineHeight: '1.35' },
+      h4: { fontSize: rem(14), lineHeight: '1.4' },
+    },
+  },
+  fontSizes: { xs: rem(12), sm: rem(13), md: rem(14), lg: rem(16), xl: rem(20) },
+  defaultRadius: 'md',
+  radius: { xs: rem(4), sm: rem(6), md: rem(8), lg: rem(12), xl: rem(16) },
+  cursorType: 'pointer',
+  focusRing: 'auto',
+  respectReducedMotion: true,
+  other: {
+    motion: { fast: '150ms', panel: '220ms', easing: 'cubic-bezier(.2,.8,.2,1)' },
+  },
+  components: {
+    Card: { defaultProps: { radius: 'lg', padding: 'lg', withBorder: true } },
+    Paper: { defaultProps: { radius: 'lg' } },
+    Badge: { defaultProps: { radius: 'xl', variant: 'light' } },
+    Tooltip: { defaultProps: { withArrow: true, openDelay: 250 } },
+    NavLink: { defaultProps: { variant: 'light' } },
+  },
+});
+
+/** Portal tokens as CSS variables (--kg-*) for both schemes; used by global.css and new pages. */
+export const portalCssVariables: CSSVariablesResolver = () => ({
+  variables: {
+    '--kg-radius-card': rem(12),
+    '--kg-motion-fast': '150ms',
+    '--kg-motion-panel': '220ms',
+    '--kg-ease': 'cubic-bezier(.2,.8,.2,1)',
+  },
+  light: {
+    '--mantine-color-body': '#F6F7FB',
+    '--kg-canvas': '#F6F7FB',
+    '--kg-surface': '#FFFFFF',
+    '--kg-raised': '#F0F2F8',
+    '--kg-border': '#E3E7F0',
+    '--kg-text': '#121722',
+    '--kg-text-2': '#5B6478',
+    '--kg-brand-soft': 'rgba(76,91,212,.10)',
+    '--kg-allowed': '#0F9D6E',
+    '--kg-blocked': '#D93A3A',
+    '--kg-limited': '#B7791F',
+    '--kg-info': '#0B84C6',
+    '--kg-shadow': '0 1px 2px rgba(16,24,40,.06), 0 1px 3px rgba(16,24,40,.10)',
+    '--kg-header-bg': 'rgba(246,247,251,.82)',
+  },
+  dark: {
+    '--mantine-color-body': '#0B0E14',
+    '--kg-canvas': '#0B0E14',
+    '--kg-surface': '#121722',
+    '--kg-raised': '#1A2130',
+    '--kg-border': '#232B3B',
+    '--kg-text': '#E8ECF4',
+    '--kg-text-2': '#9AA4B8',
+    '--kg-brand-soft': 'rgba(124,140,255,.14)',
+    '--kg-allowed': '#34D399',
+    '--kg-blocked': '#F87171',
+    '--kg-limited': '#FBBF24',
+    '--kg-info': '#38BDF8',
+    '--kg-shadow': 'inset 0 1px 0 rgba(255,255,255,.03)',
+    '--kg-header-bg': 'rgba(11,14,20,.78)',
+  },
+});
+
+/** antd tokens matching the portal theme (some upstream pages render antd tables/forms). */
+export const antdTokens = (scheme: 'light' | 'dark') => ({
+  colorPrimary: scheme === 'dark' ? '#7C8CFF' : '#4C5BD4',
+  colorBgContainer: scheme === 'dark' ? '#121722' : '#FFFFFF',
+  colorBgElevated: scheme === 'dark' ? '#1A2130' : '#FFFFFF',
+  colorBgLayout: scheme === 'dark' ? '#0B0E14' : '#F6F7FB',
+  colorBorder: scheme === 'dark' ? '#2A3346' : '#E3E7F0',
+  colorBorderSecondary: scheme === 'dark' ? '#232B3B' : '#EEF1F6',
+  colorText: scheme === 'dark' ? '#E8ECF4' : '#121722',
+  colorTextSecondary: scheme === 'dark' ? '#9AA4B8' : '#5B6478',
+  borderRadius: 8,
+  borderRadiusSM: 6,
+  fontFamily: '"Inter Variable", Inter, system-ui, -apple-system, "Segoe UI", sans-serif',
