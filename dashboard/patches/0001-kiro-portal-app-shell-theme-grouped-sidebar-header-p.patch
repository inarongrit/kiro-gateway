+/* App shell: grouped sidebar, translucent header. Tokens come from kiro/theme.ts (--kg-*). */
+.navbar {
+  background: var(--kg-surface);
+  border-right: 1px solid var(--kg-border);
+  display: flex;
+  flex-direction: column;
+  transition: width var(--kg-motion-panel) var(--kg-ease);
+}
+
+.brand {
+  height: 56px;
+  padding: 0 16px;
+  flex: none;
+  border-bottom: 1px solid var(--kg-border);
+}
+
+.navbar[data-collapsed] .brand {
+  justify-content: center;
+  padding: 0;
+}
+
+.scroll {
+  flex: 1;
+  padding: 8px 10px;
+}
+
+.group + .group {
+  margin-top: 6px;
+}
+
+.groupLabel {
+  padding: 14px 10px 6px;
+  font-size: 11px;
+  font-weight: 600;
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
+  color: var(--kg-text-2);
+}
+
+.groupRule {
+  height: 1px;
+  margin: 10px 14px;
+  background: var(--kg-border);
+}
+
+.link {
+  border-radius: var(--mantine-radius-md);
+  padding: 7px 10px;
+  color: var(--kg-text-2);
+  font-size: 13.5px;
+  transition:
+    background-color var(--kg-motion-fast) var(--kg-ease),
+    color var(--kg-motion-fast) var(--kg-ease);
+
+  &:hover {
+    background: var(--kg-raised);
+    color: var(--kg-text);
+  }
+
+  &[data-active] {
+    background: var(--kg-brand-soft);
+    color: var(--mantine-primary-color-filled);
+    font-weight: 550;
+  }
+
+  & :global(.mantine-NavLink-section) {
+    margin-inline-end: 10px;
+  }
+}
+
+.navbar[data-collapsed] .link {
+  justify-content: center;
+  padding: 9px 0;
+
+  & :global(.mantine-NavLink-section) {
+    margin-inline-end: 0;
+  }
+
+  & :global(.mantine-NavLink-body) {
+    display: none;
+  }
+}
+
+.footer {
+  padding: 10px;
+  border-top: 1px solid var(--kg-border);
+  flex: none;
+}
+
+.healthCard {
+  padding: 10px 12px;
+  border-radius: var(--mantine-radius-md);
+  background: var(--kg-raised);
+}
+
+.dot {
+  width: 8px;
+  height: 8px;
+  border-radius: 50%;
+  flex: none;
+  background: var(--kg-text-2);
+
+  &[data-state='ok'] {
+    background: var(--kg-allowed);
+    box-shadow: 0 0 0 3px color-mix(in srgb, var(--kg-allowed) 25%, transparent);
+  }
+
+  &[data-state='bad'] {
+    background: var(--kg-blocked);
+    box-shadow: 0 0 0 3px color-mix(in srgb, var(--kg-blocked) 25%, transparent);
+  }
+}
+
+.collapseBtn {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  padding: 7px 10px;
+  border-radius: var(--mantine-radius-md);
+  color: var(--kg-text-2);
+
+  &:hover {
+    background: var(--kg-raised);
+    color: var(--kg-text);
+  }
+}
+
+.navbar[data-collapsed] .collapseBtn {
+  justify-content: center;
+}
+
+.header {
+  background: var(--kg-header-bg);
+  backdrop-filter: saturate(140%) blur(10px);
+  border-bottom: 1px solid var(--kg-border);
+}
+
+.search {
+  width: 300px;
+  justify-content: flex-start;
+  color: var(--kg-text-2);
+  background: var(--kg-raised);
+  border: 1px solid var(--kg-border);
+  font-weight: 400;
+
+  &:hover {
+    background: var(--kg-raised);
+    border-color: var(--mantine-primary-color-filled);
+  }
+}
+
+.kbd {
+  margin-left: auto;
+  font-size: 11px;
+}
+
+.searchInner {
+  justify-content: flex-start;
+}
+
+.searchLabel {
+  flex: 1;
+  display: flex;
+  align-items: center;
+  gap: 8px;
+}
+
+.healthPill {
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  padding: 4px 10px;
+  border-radius: 999px;
+  border: 1px solid var(--kg-border);
+  font-size: 12.5px;
+  color: var(--kg-text-2);
+}
+
+.main {
+  background: var(--kg-canvas);
+  min-height: 100dvh;
+}
