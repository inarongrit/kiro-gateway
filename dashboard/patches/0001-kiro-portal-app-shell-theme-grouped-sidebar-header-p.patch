+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+/* Kiro portal: global polish applied to every page (upstream APISIX pages included). */
+html,
+body {
+  background: var(--kg-canvas);
+  font-feature-settings: 'cv11', 'ss01';
+  -webkit-font-smoothing: antialiased;
+}
+
+/* Numbers in tables and metrics line up. */
+.mantine-Table-td,
+.ant-table-cell,
+.kg-num {
+  font-variant-numeric: tabular-nums;
+}
+
+/* Cards and papers share the portal surface, border and elevation. */
+.mantine-Card-root,
+.mantine-Paper-root[data-with-border] {
+  background: var(--kg-surface);
+  border-color: var(--kg-border);
+  box-shadow: var(--kg-shadow);
+}
+
+/* Upstream editor frames follow the scheme instead of fixed light greys. */
+.editor-wrapper {
+  border-color: var(--kg-border) !important;
+}
+.editor-wrapper:focus-within {
+  border-color: var(--mantine-primary-color-filled) !important;
+}
+.editor-wrapper--disabled {
+  background-color: var(--kg-raised) !important;
+}
+
+/* antd tables (Services list etc.) blend into portal cards. */
+.ant-pro-table .ant-pro-card,
+.ant-pro-table-list-toolbar-container {
+  background: transparent;
+}
+.ant-table-wrapper .ant-table {
+  background: var(--kg-surface);
+  border-radius: var(--kg-radius-card);
+}
+.ant-table-wrapper .ant-table-thead > tr > th {
+  background: var(--kg-raised);
+  color: var(--kg-text-2);
+  font-weight: 600;
+  font-size: 12px;
+  text-transform: uppercase;
+  letter-spacing: 0.04em;
+}
+
+/* Subtle scrollbars. */
+* {
+  scrollbar-width: thin;
+  scrollbar-color: var(--kg-border) transparent;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    transition: none !important;
+    animation: none !important;
+  }
+}
