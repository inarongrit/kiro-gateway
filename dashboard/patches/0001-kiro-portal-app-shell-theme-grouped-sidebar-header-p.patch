+const ThemeToggle = () => {
+  const { t } = useTranslation();
+  const { setColorScheme } = useMantineColorScheme();
+  const scheme = useComputedColorScheme('dark');
+  const label = scheme === 'dark' ? t('kiro.header.themeLight') : t('kiro.header.themeDark');
+  return (
+    <Tooltip label={label}>
+      <ActionIcon
+        variant="default"
+        size="lg"
+        aria-label={label}
+        onClick={() => setColorScheme(scheme === 'dark' ? 'light' : 'dark')}
+      >
+        {scheme === 'dark' ? <IconSun width={18} height={18} /> : <IconMoon width={18} height={18} />}
+      </ActionIcon>
+    </Tooltip>
+  );
+};
+
+const HealthPill = () => {
+  const { t } = useTranslation();
+  const { data } = useQuery({ queryKey: ['kiro', 'status'], queryFn: getStatus, refetchInterval: 30_000 });
+  const state = data ? (data.healthy ? 'ok' : 'bad') : 'unknown';
+  const detail = data
+    ? t('kiro.header.healthDetail', {
+        dp: data.data_plane ? t('kiro.header.up') : t('kiro.header.down'),
+        admin: data.admin_api ? t('kiro.header.up') : t('kiro.header.down'),
+      })
+    : t('kiro.header.checking');
+  return (
+    <Tooltip label={detail}>
+      <span className={classes.healthPill} role="status">
+        <span className={classes.dot} data-state={state} aria-hidden />
+        {data ? (data.healthy ? t('kiro.header.healthy') : t('kiro.header.degraded')) : t('kiro.header.checking')}
+      </span>
+    </Tooltip>
+  );
+};
+
+const UserMenu = () => {
+  const { t } = useTranslation();
+  const { data } = useQuery({ queryKey: ['kiro', 'me'], queryFn: getMe, staleTime: 300_000 });
+  const user = data?.user ?? '…';
+  return (
+    <Menu position="bottom-end" width={240} shadow="md">
+      <Menu.Target>
+        <ActionIcon variant="subtle" size="lg" radius="xl" aria-label={t('kiro.header.userMenu')}>
+          <Avatar size={32} radius="xl" color="indigo">
+            {user.slice(0, 2).toUpperCase()}
+          </Avatar>
+        </ActionIcon>
+      </Menu.Target>
+      <Menu.Dropdown>
+        <Menu.Label>
+          {t('kiro.header.signedInAs')} <b>{user}</b>
+        </Menu.Label>
+        <Menu.Item component="a" href="/grafana/" target="_blank" rel="noopener noreferrer" leftSection={<IconChart width={16} />}>
+          {t('kiro.header.grafana')}
+        </Menu.Item>
+        <Menu.Item component="a" href="/" leftSection={<IconConsole width={16} />}>
+          {t('kiro.header.classicConsole')}
+        </Menu.Item>
+        <Menu.Item
+          component="a"
+          href="https://apisix.apache.org/docs/"
+          target="_blank"
+          rel="noopener noreferrer"
+          leftSection={<IconBook width={16} />}
+        >
+          {t('kiro.header.docs')}
+        </Menu.Item>
+        <Menu.Divider />
+        <Menu.Item color="red" leftSection={<IconLogout width={16} />} onClick={() => void signOut()}>
+          {t('kiro.header.signOut')}
+        </Menu.Item>
+      </Menu.Dropdown>
+    </Menu>
+  );
+};
+
+/** Lightweight page search (⌘K / Ctrl+K) over every portal and gateway page. */
+const PageSearch = () => {
+  const { t } = useTranslation();
+  const navigate = useNavigate();
+  const [opened, { open, close }] = useDisclosure(false);
+  const [q, setQ] = useState('');
+  useHotkeys([['mod+K', () => open()]]);
+  const pages = useMemo(
+    () =>
+      navGroups.flatMap((g) =>
+        (g.items as Array<PortalNavItem | NavRoute>).map((i) => ({
+          to: i.to as string,
+          icon: i.icon,
+          label: itemLabel(t, g, i),
+          group: groupLabel(t, g),
+        }))
+      ),
+    [t]
+  );
+  const hits = pages.filter((p) => `${p.label} ${p.group}`.toLowerCase().includes(q.trim().toLowerCase()));
+  const go = (to: string) => {
+    close();
+    setQ('');
+    void navigate({ to });
+  };
+  return (
+    <>
+      <Button
+        className={classes.search}
+        classNames={{ inner: classes.searchInner, label: classes.searchLabel }}
+        variant="default"
+        onClick={open}
+        leftSection={<IconSearch width={16} />}
+        visibleFrom="md"
+      >
+        {t('kiro.header.searchHint')}
+        <Kbd className={classes.kbd} size="xs">
+          {t('kiro.header.shortcut')}
+        </Kbd>
+      </Button>
+      <ActionIcon variant="default" size="lg" onClick={open} aria-label={t('kiro.header.search')} hiddenFrom="md">
+        <IconSearch width={18} />
+      </ActionIcon>
+      <Modal opened={opened} onClose={close} withCloseButton={false} padding="sm" radius="lg" size="md" yOffset="12vh">
+        <TextInput
+          data-autofocus
+          size="md"
+          placeholder={t('kiro.header.searchHint')}
+          leftSection={<IconSearch width={16} />}
+          value={q}
+          onChange={(e) => setQ(e.currentTarget.value)}
+          onKeyDown={(e) => {
+            if (e.key === 'Enter' && hits[0]) go(hits[0].to);
+          }}
+          aria-label={t('kiro.header.search')}
+        />
+        <Stack gap={2} mt="xs" mah={360} style={{ overflowY: 'auto' }}>
+          {hits.map(({ to, label, group, icon: Icon }) => (
+            <NavLink
+              key={to}
+              label={label}
+              description={group}
+              leftSection={<Icon width={18} height={18} aria-hidden />}
+              onClick={() => go(to)}
+              style={{ borderRadius: 8 }}
+            />
+          ))}
+          {!hits.length && (
+            <Text c="dimmed" size="sm" p="sm">
+              {t('noData')}
+            </Text>
+          )}
+        </Stack>
+      </Modal>
+    </>
+  );
+};
+
+type Props = { opened: boolean; toggle: () => void };
+
+export const PortalHeader: FC<Props> = ({ opened, toggle }) => {
+  const { t } = useTranslation();
+  return (
+    <AppShell.Header className={classes.header}>
+      <Group h="100%" px={{ base: 'sm', sm: 'lg' }} justify="space-between" wrap="nowrap" gap="sm">
+        <Group gap="sm" wrap="nowrap">
+          <Burger opened={opened} onClick={toggle} hiddenFrom="sm" size="sm" aria-label={t('a11y.toggleNavigation')} />
+          <Group gap={8} hiddenFrom="sm" wrap="nowrap">
+            <BrandMark size={26} />
+            <Text fw={650} style={{ whiteSpace: 'nowrap' }} visibleFrom="xs">
+              {t('kiro.brand.name')}
+            </Text>
+          </Group>
+          <PageSearch />
+        </Group>
+        <Group gap="xs" wrap="nowrap">
+          <Group visibleFrom="sm">
+            <HealthPill />
+          </Group>
+          <ThemeToggle />
+          <SettingModalBtn />
+          <Group visibleFrom="sm">
+            <LanguageMenu />
+          </Group>
+          <UserMenu />
+        </Group>
+      </Group>
+    </AppShell.Header>
+  );
+};
