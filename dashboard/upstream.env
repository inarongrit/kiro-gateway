# Upstream APISIX dashboard that our fork is based on.
# APISIX 3.19.0 ships this exact commit (apache/apisix .requirements: APISIX_DASHBOARD_COMMIT).
# To upgrade: set the commit APISIX's new .requirements pins, run scripts/dashboard.sh prepare,
# resolve any patch conflicts, then scripts/dashboard.sh save && scripts/dashboard.sh build.
UPSTREAM_REPO=https://github.com/apache/apisix-dashboard.git
UPSTREAM_COMMIT=fa2fd0f60f8afffb096476333b9ba63b4c518fa3
NODE_IMAGE=node:22.23.3-bookworm   # full image: the build reads git metadata
PNPM_VERSION=10.34.4
