# Kiro Gateway settings. Copy to .env (scripts/init.sh does this and fills in the secrets).
# .env is git-ignored. Never commit real values.

# ---- secrets: leave empty, scripts/init.sh generates them -------------------------------------
APISIX_ADMIN_KEY=
AI_GW_DEMO_KEY=
AI_GW_MOCK_TOKEN=
# Console sign-in. init.sh sets CONSOLE_USER=admin with a random password written to
# pki/console-initial-password (0600). Change later: scripts/console-passwd.sh <user> --stdin
CONSOLE_USER=
CONSOLE_PASSWORD_HASH=
# Optional: real LLM provider for the OpenAI-compatible AI route (otherwise a local mock LLM).
# OPENAI_API_KEY=

# ---- network exposure ------------------------------------------------------------------------
# Address the console/portal (HTTPS) and the Kiro proxy publish on. 127.0.0.1 = this host only.
# On a server behind a load balancer or in a private subnet use 0.0.0.0 and restrict with the
# CIDR lists below plus security groups / firewall rules.
KGW_BIND_ADDR=127.0.0.1
KGW_PORT=9180
KGW_PROXY_BIND_ADDR=127.0.0.1
# Who may use the portal (comma-separated CIDRs). Keep 127.0.0.0/8 and 172.30.0.1/32 (scripts on
# this host); add your operator network / VPN / load-balancer subnet, e.g. ...,10.0.0.0/16
CONSOLE_ALLOW_CIDRS=127.0.0.0/8,172.30.0.1/32
# Only behind a reverse proxy / CDN that sets CloudFront-Viewer-Address (the AWS stack sets this
# to the VPC range): requests from these networks are attributed to the viewer IP in that header.
# Leave empty for direct connections; never list networks a client could connect from.
CONSOLE_TRUSTED_PROXY_CIDRS=
# Who may use the Kiro proxy on :3128 (comma-separated CIDRs, besides this host). Empty = local only.
KGW_PROXY_ALLOW_CIDRS=
# Extra names/IPs for the portal's TLS certificate (comma-separated), e.g. gateway.example.com
# (127.0.0.1 and localhost are always included). Ignored if pki/admin/admin.crt already exists.
KGW_PUBLIC_NAMES=

# ---- second guardrail layer: Amazon Bedrock Guardrails (optional) -----------------------------
# Create the guardrail (deploy/ does it for you on AWS, or see docs/evaluation/bedrock-guardrail.json),
# then set its id/version. Empty id = layer not configured; keep it switched off on the Rules page.
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=1
AWS_REGION=us-east-1

# ---- logging ---------------------------------------------------------------------------------
# masked (default): prompts are stored with every rule match masked. off: no prompt text at all.
PROMPT_LOG=masked
