{
  "uid": "kiro-gateway-logs",
  "title": "4 \u00b7 Logs & traces",
  "description": "Search the audit log and jump to traces.",
  "tags": [
    "kiro-gateway"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": false,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 27,
      "type": "text",
      "title": "How to use",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Filter with the variables above, or type text into **Search** (matches prompt, user, rule). Expand a log line and click **Open trace** to see the request in Tempo. Traces \u2192 logs works the other way from the trace view."
      }
    },
    {
      "id": 28,
      "type": "timeseries",
      "title": "Matching events",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "sum by (result) (count_over_time({kind=~\"$kind\", path=~\"$path\", result=~\"$result\", rule=~\"$rule\"} |= \"$search\" [$__auto]))",
          "legendFormat": "{{result}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "allowed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "blocked"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "rate_limited"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "error"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 29,
      "type": "logs",
      "title": "Audit log",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "{kind=~\"$kind\", path=~\"$path\", result=~\"$result\", rule=~\"$rule\"} |= \"$search\" | json | line_format `{{.status}} {{.host}}{{.uri}} [{{.rule}}] {{.user}} \u00b7 {{ regexReplaceAll \"\\\\s*--- USER MESSAGE END ---[\\\\s\\\\S]*$\" (regexReplaceAll \"^[\\\\s\\\\S]*--- USER MESSAGE BEGIN ---\\\\s*\" .prompt \"\") \"\" }}`",
          "legendFormat": "",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    },
    {
      "id": 30,
      "type": "table",
      "title": "Recent traces (Tempo)",
      "description": "Chat/API requests (POST). Click a Trace ID to open the span breakdown (access phase, upstream, response streaming).",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "limit": 50,
          "query": "{resource.service.name=\"kiro-gateway\" && name =~ \"POST.*\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "nested": true
            }
          }
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "path",
        "label": "Path",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "refresh": 2,
        "query": {
          "label": "path",
          "stream": "{kind=~\".+\"}",
          "type": 1
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "result",
        "label": "Result",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "refresh": 2,
        "query": {
          "label": "result",
          "stream": "{kind=~\".+\"}",
          "type": 1
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "rule",
        "label": "Rule",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "refresh": 2,
        "query": {
          "label": "rule",
          "stream": "{kind=~\".+\"}",
          "type": 1
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "kind",
        "label": "Kind",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "refresh": 2,
        "query": {
          "label": "kind",
          "stream": "{kind=~\".+\"}",
          "type": 1
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "text": "chat",
          "value": "chat"
        }
      },
      {
        "name": "search",
        "label": "Search",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "links": [
    {
      "title": "Kiro Gateway",
      "type": "dashboards",
      "tags": [
        "kiro-gateway"
      ],
      "asDropdown": true
    },
    {
      "title": "Guardrail Console",
      "type": "link",
      "url": "/",
      "targetBlank": false
    }
  ]
}
