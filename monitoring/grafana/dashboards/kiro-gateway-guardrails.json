{
  "uid": "kiro-gateway-guardrails",
  "title": "2 \u00b7 Guardrails",
  "description": "What the guardrail rules allowed and blocked (Loki, from the APISIX audit log).",
  "tags": [
    "kiro-gateway"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 10,
      "type": "stat",
      "title": "Chats checked",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "sum(count_over_time({kind=\"chat\"}[$__range]))",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Blocked",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "sum(count_over_time({kind=\"chat\", result=\"blocked\"}[$__range])) or vector(0)",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "PII / secret blocks",
      "description": "Blocks by the PII and secret rules (email, ID, card, phone, SSN, keys) and by Bedrock Guardrails PII detection (names, addresses, ...).",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "sum(count_over_time({kind=\"chat\", result=\"blocked\", rule=~\"pii-.*|secret-.*|aws-.*|bedrock:pii:.*|bedrock:regex:.*\"}[$__range])) or vector(0)",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Block rate",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "sum(count_over_time({kind=\"chat\", result=\"blocked\"}[$__range])) / sum(count_over_time({kind=\"chat\"}[$__range]))",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Allowed vs blocked over time",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 14,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "sum by (result) (count_over_time({kind=\"chat\"}[$__auto]))",
          "legendFormat": "{{result}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "allowed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "blocked"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "rate_limited"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "error"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 15,
      "type": "barchart",
      "title": "Blocks by rule",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 14,
        "y": 4,
        "w": 10,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "sum by (rule) (count_over_time({kind=\"chat\", result=\"blocked\"}[$__range]))",
          "legendFormat": "{{rule}}",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xField": "rule",
        "showValue": "always",
        "legend": {
          "showLegend": false
        },
        "barWidth": 0.7
      }
    },
    {
      "id": 16,
      "type": "barchart",
      "title": "Blocks by path",
      "description": "kiro = Kiro CLI/IDE; ai = /v1/chat/completions",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 7,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "sum by (path) (count_over_time({kind=\"chat\", result=\"blocked\"}[$__range]))",
          "legendFormat": "{{path}}",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xField": "path",
        "showValue": "always",
        "legend": {
          "showLegend": false
        },
        "barWidth": 0.7
      }
    },
    {
      "id": 17,
      "type": "barchart",
      "title": "Users with most blocks",
      "description": "Kiro users are a hash of their token (rotates on refresh); AI route users are consumer names.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 7,
        "y": 12,
        "w": 17,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "topk(10, sum by (user) (count_over_time({kind=\"chat\", result=\"blocked\"}[$__range])))",
          "legendFormat": "{{user}}",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xField": "user",
        "showValue": "always",
        "legend": {
          "showLegend": false
        },
        "barWidth": 0.7
      }
    },
    {
      "id": 18,
      "type": "logs",
      "title": "Recent blocked prompts",
      "description": "Kiro prompts (only the user's words). AI route prompts are not stored. Expand a line for trace_id \u2192 Tempo.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "{kind=\"chat\", result=\"blocked\"} | json | line_format `[{{.rule}}] {{.user}} \u00b7 {{ regexReplaceAll \"\\\\s*--- USER MESSAGE END ---[\\\\s\\\\S]*$\" (regexReplaceAll \"^[\\\\s\\\\S]*--- USER MESSAGE BEGIN ---\\\\s*\" .prompt \"\") \"\" }}`",
          "legendFormat": "",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    }
  ],
  "templating": {
    "list": []
  },
  "links": [
    {
      "title": "Kiro Gateway",
      "type": "dashboards",
      "tags": [
        "kiro-gateway"
      ],
      "asDropdown": true
    },
    {
      "title": "Guardrail Console",
      "type": "link",
      "url": "/",
      "targetBlank": false
    }
  ]
}
