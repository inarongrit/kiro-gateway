{
  "name": "kiro-gateway-deploy",
  "version": "0.1.0",
  "private": true,
  "description": "AWS infrastructure for Kiro Gateway (CDK; also synthesized to a plain CloudFormation template)",
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "synth": "cdk synth --quiet",
    "template": "cdk synth --quiet && node scripts/export-templates.mjs"
  },
  "dependencies": {
    "aws-cdk-lib": "2.272.0",
    "cdk-nag": "3.0.2",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "aws-cdk": "2.1144.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
